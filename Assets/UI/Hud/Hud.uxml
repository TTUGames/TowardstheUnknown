<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Bound by Hud and its panels: the timeline items and skills are created from the turn order and the inventory -->
    <ui:VisualElement name="Hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="Popups" class="hud" picking-mode="Ignore" />

        <SlantedLabel name="Banner" class="banner panel caps" corners="TopLeft, BottomRight" picking-mode="Ignore" />

        <SlantedPanel name="BossBar" class="boss-bar panel" corners="TopLeft, BottomRight" dots="TopRight" picking-mode="Ignore">
            <ui:Label name="BossName" class="boss-bar__name caps" />
            <ui:VisualElement class="boss-bar__track" picking-mode="Ignore">
                <HealthBar />
                <ui:VisualElement name="BossPhaseMark" class="boss-bar__phase" picking-mode="Ignore" />
            </ui:VisualElement>
        </SlantedPanel>

        <SlantedPanel name="EntityInfo" class="entity-info panel fade-in" corners="All" picking-mode="Ignore">
            <ui:Label name="EntityName" class="entity-info__name" />
            <ui:VisualElement class="entity-info__separator" />
            <ui:VisualElement class="entity-info__stats">
                <ui:Label name="EntityHealth" class="entity-info__health" />
                <ui:Label name="EntityArmor" class="entity-info__armor" />
                <ui:Label text="|" />
                <ui:Label name="EntityMovement" class="entity-info__movement" />
            </ui:VisualElement>
            <ui:Label name="EntityEffects" class="entity-info__effects" />
        </SlantedPanel>

        <ui:VisualElement name="StatusEffects" class="status-effects" picking-mode="Ignore">
            <ui:VisualElement name="Attack" class="status-effect status-effect--attack"><ui:Label picking-mode="Ignore" /></ui:VisualElement>
            <ui:VisualElement name="Defense" class="status-effect status-effect--defense"><ui:Label picking-mode="Ignore" /></ui:VisualElement>
        </ui:VisualElement>
        <SlantedLabel name="StatusTooltip" class="tooltip tooltip--status panel fade-in" corners="All" picking-mode="Ignore" />

        <SlantedPanel name="Status" class="hud-panel hud-status panel" corners="TopLeft, BottomRight" dots="TopRight">
            <HealthBar />
            <EnergyGauge />
        </SlantedPanel>

        <SlantedButton name="Action" class="hud-panel hud-action panel caps" corners="BottomLeft, BottomRight" dots="TopLeft, TopRight" />

        <SlantedPanel name="Timeline" class="hud-panel hud-timeline panel" corners="TopRight, BottomLeft" dots="TopLeft" />

        <ui:VisualElement name="Skills" class="skills" picking-mode="Ignore" />
        <SlantedLabel name="Tooltip" class="tooltip panel fade-in" corners="All" picking-mode="Ignore" />

        <SlantedButton name="Bag" class="hud-bag panel caps" key="BagButton" />

        <SlantedPanel name="Minimap" class="minimap panel" picking-mode="Ignore">
            <ui:VisualElement class="minimap__view" picking-mode="Ignore">
                <ui:VisualElement name="MinimapRooms" class="minimap__rooms" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="dot dot--left dot--bottom" />
        </SlantedPanel>

        <ui:VisualElement name="Fade" class="fade" />
    </ui:VisualElement>
</ui:UXML>
