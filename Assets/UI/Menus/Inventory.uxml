<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:l="UnityEngine.Localization">
    <!-- Bound by InventoryScreen: the grids are filled by TetrisInventory, the texts from the player and the pressed artifact -->
    <ui:VisualElement name="Inventory" class="screen inventory">
        <ui:VisualElement name="PlayerInfo" class="inventory-panel inventory-panel--left glass cut">
            <ui:VisualElement class="hud-dot hud-dot--right" />
            <ui:Label name="PlayerName" class="inventory-panel__title" />
            <ui:Label class="inventory-panel__subtitle"><Bindings><l:LocalizedString property="text" table="UI" entry="PlayerStatusSubtitle" /></Bindings></ui:Label>
            <ui:VisualElement class="player-info">
                <ui:VisualElement class="player-info__portrait" />
                <ui:VisualElement class="player-info__stats">
                    <ui:Label class="player-info__header caps"><Bindings><l:LocalizedString property="text" table="UI" entry="PlayerStatsHeader" /></Bindings></ui:Label>
                    <ui:Label name="StatsHealth" class="player-info__line caps" />
                    <ui:Label name="StatsEnergy" class="player-info__line caps" />
                    <ui:Label name="StatsAttack" class="player-info__line caps" />
                    <ui:Label name="StatsDefense" class="player-info__line caps" />
                    <ui:Label class="player-info__header caps"><Bindings><l:LocalizedString property="text" table="UI" entry="PlayerProgressHeader" /></Bindings></ui:Label>
                    <ui:Label name="KameikoCount" class="player-info__line caps" />
                    <ui:Label name="NanukoCount" class="player-info__line caps" />
                    <ui:Label name="GolemCount" class="player-info__line caps" />
                    <ui:Label name="VisitedRooms" class="player-info__line caps" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label class="player-info__zone-title caps"><Bindings><l:LocalizedString property="text" table="UI" entry="ZoneInfoZeroHeader" /></Bindings></ui:Label>
            <ui:Label class="player-info__zone-text"><Bindings><l:LocalizedString property="text" table="UI" entry="ZoneInfoZeroContent" /></Bindings></ui:Label>
            <ui:Label name="Score" class="player-info__score caps" />
        </ui:VisualElement>

        <ui:VisualElement name="Chest" class="inventory-panel inventory-panel--left glass cut hidden">
            <ui:VisualElement class="hud-dot hud-dot--right" />
            <ui:Label class="inventory-panel__title caps"><Bindings><l:LocalizedString property="text" table="UI" entry="ChestInventoryTitle" /></Bindings></ui:Label>
            <ui:Label class="inventory-panel__subtitle"><Bindings><l:LocalizedString property="text" table="UI" entry="ChestInventorySubtitle" /></Bindings></ui:Label>
            <ui:VisualElement name="ChestGrid" class="inventory-grid" />
        </ui:VisualElement>

        <ui:VisualElement name="Description" class="inventory-panel inventory-panel--center glass cut">
            <ui:Label class="inventory-panel__title caps"><Bindings><l:LocalizedString property="text" table="UI" entry="InventoryArtifactTitle" /></Bindings></ui:Label>
            <ui:Label class="inventory-panel__subtitle"><Bindings><l:LocalizedString property="text" table="UI" entry="InventoryArtifactSubtitle" /></Bindings></ui:Label>
            <ui:VisualElement name="ArtifactIcon" class="artifact-info__icon" />
            <ui:VisualElement class="artifact-info__costs">
                <ui:VisualElement class="artifact-info__cost">
                    <ui:Label name="ArtifactCooldown" class="artifact-info__cooldown" text="0" />
                    <ui:Label class="artifact-info__hint artifact-info__hint--left"><Bindings><l:LocalizedString property="text" table="UI" entry="ArtifactCooldownHint" /></Bindings></ui:Label>
                </ui:VisualElement>
                <ui:VisualElement class="artifact-info__cost artifact-info__cost--energy">
                    <ui:Label name="ArtifactCost" class="artifact-info__energy" text="0" />
                    <ui:Label class="artifact-info__hint artifact-info__hint--right"><Bindings><l:LocalizedString property="text" table="UI" entry="ArtifactCostHint" /></Bindings></ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="artifact-info__box">
                <ui:Label name="ArtifactTitle" class="artifact-info__box-title caps" />
                <ui:Label name="ArtifactText" class="artifact-info__box-text" />
            </ui:VisualElement>
            <ui:VisualElement class="artifact-info__box">
                <ui:Label class="artifact-info__box-title caps"><Bindings><l:LocalizedString property="text" table="UI" entry="ArtifactEffectsHeader" /></Bindings></ui:Label>
                <ui:Label name="ArtifactEffects" class="artifact-info__box-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="PlayerInventory" class="inventory-panel inventory-panel--right glass cut">
            <ui:VisualElement class="hud-dot hud-dot--left" />
            <ui:Label class="inventory-panel__title caps"><Bindings><l:LocalizedString property="text" table="UI" entry="PlayerInventoryTitle" /></Bindings></ui:Label>
            <ui:Label class="inventory-panel__subtitle"><Bindings><l:LocalizedString property="text" table="UI" entry="PlayerInventorySubtitle" /></Bindings></ui:Label>
            <ui:VisualElement name="PlayerGrid" class="inventory-grid" />
        </ui:VisualElement>

        <ui:VisualElement name="Hand" class="inventory__hand" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
