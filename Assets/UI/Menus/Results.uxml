<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:l="UnityEngine.Localization">
    <ui:VisualElement name="Results" class="screen results">
        <ui:VisualElement class="backdrop backdrop--dark" />
        <ui:Label name="Message" class="title caps results__message" />
        <ui:Label name="Score" class="section-title caps results__score" />
        <ui:VisualElement class="results__buttons">
            <ui:Button name="Restart" class="outline-button"><Bindings><l:LocalizedString property="text" table="UI" entry="EndScreenRestart" /></Bindings></ui:Button>
            <ui:Button name="MainMenu" class="outline-button"><Bindings><l:LocalizedString property="text" table="UI" entry="EndScreenMainMenu" /></Bindings></ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
