<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Settings shared by the main menu and the pause menu, bound by OptionsView. Sliders are named after GameSetting -->
    <ui:VisualElement name="Options" class="view">
        <LocalizedLabel key="OptionsTitle" class="title caps" />
        <ui:VisualElement class="separator" />

        <LocalizedLabel key="OptionsVideoHeader" class="section-title caps" />
        <ui:VisualElement class="setting">
            <LocalizedLabel key="OptionsLuminosity" />
            <ui:Slider name="Luminosity" low-value="-2" high-value="2" class="setting-slider" />
        </ui:VisualElement>
        <ui:VisualElement class="setting">
            <LocalizedLabel key="OptionsContrast" />
            <ui:Slider name="Contrast" low-value="-80" high-value="80" class="setting-slider" />
        </ui:VisualElement>
        <SlantedButton name="ResetVideo" key="OptionsResetToDefault" class="outline-button panel" corners="TopLeft, BottomRight" />
        <ui:VisualElement class="separator" />

        <LocalizedLabel key="OptionsAudioHeader" class="section-title caps" />
        <ui:VisualElement class="setting">
            <LocalizedLabel key="OptionsMusicVolume" />
            <ui:Slider name="MusicVolume" low-value="0" high-value="100" class="setting-slider" />
        </ui:VisualElement>
        <ui:VisualElement class="setting">
            <LocalizedLabel key="OptionsEffectsVolume" />
            <ui:Slider name="SFXVolume" low-value="0" high-value="100" class="setting-slider" />
        </ui:VisualElement>
        <SlantedButton name="ResetAudio" key="OptionsResetToDefault" class="outline-button panel" corners="TopLeft, BottomRight" />
        <ui:VisualElement class="separator" />

        <SlantedButton name="Back" key="MenuReturn" class="outline-button panel" corners="TopLeft, BottomRight" />
    </ui:VisualElement>
</ui:UXML>
