<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Options" src="Options.uxml" />

    <ui:VisualElement name="Home" class="screen stretch main-menu">
        <ui:VisualElement class="main-menu__logo" />
        <LocalizedLabel key="MenuEditionSubtitle" class="main-menu__edition caps" picking-mode="Ignore" />
        <ui:VisualElement class="main-menu__buttons menu-list">
            <!-- Shown with a suspended run (MainMenu.RefreshContinue) -->
            <MenuButton name="Continue" key="MenuContinue" class="main-menu__play hidden" />
            <ui:VisualElement class="separator separator--blank main-menu__continue-separator hidden" />
            <MenuButton name="Play" key="MenuPlay" class="main-menu__play" />
            <ui:VisualElement class="separator separator--blank" />
            <MenuButton name="OpenOptions" key="MenuOptions" />
            <ui:VisualElement class="separator separator--blank" />
            <MenuButton name="OpenCredits" key="MenuCredits" />
            <ui:VisualElement class="separator separator--blank" />
            <MenuButton name="Quit" key="MenuQuitGame" />
        </ui:VisualElement>
        <!-- The best score of the random runs, once there is one (MainMenu.RefreshBest) -->
        <ui:Label name="BestScore" class="main-menu__best hidden" picking-mode="Ignore" />
        <!-- The version and the edition played; opens the options, where the edition is chosen (MainMenu.RefreshBadge) -->
        <SlantedButton name="EditionBadge" class="outline-button panel edition-badge" corners="TopLeft, BottomRight" />
    </ui:VisualElement>

    <ui:VisualElement name="OptionsScreen" class="screen stretch">
        <ui:VisualElement class="backdrop stretch" />
        <SlantedPanel class="side-panel side-panel--wide panel" corners="TopLeft">
            <ui:Instance template="Options" class="view" />
        </SlantedPanel>
    </ui:VisualElement>

    <ui:VisualElement name="Credits" class="screen stretch">
        <ui:VisualElement class="backdrop stretch" />
        <SlantedPanel class="side-panel panel" corners="TopLeft">
            <LocalizedLabel key="MenuCredits" class="title caps" />
            <ui:VisualElement class="separator" />
            <ui:VisualElement class="credits">
                <ui:VisualElement class="credits__content">
                    <LocalizedLabel key="CreditsAnniversary" class="credits__role caps" />
                    <ui:Label text="Bastien OKONSKI" class="credits__names" />
                    <LocalizedLabel key="CreditsConcept" class="credits__role caps" />
                    <ui:Label text="Lucas DANSAC&#10;Jorick REGOTTAZ&#10;Bastien OKONSKI&#10;Florian BOIREAU" class="credits__names" />
                    <LocalizedLabel key="CreditsGameDesign" class="credits__role caps" />
                    <ui:Label text="Pierre BIGAUD&#10;Lucas DANSAC&#10;Raphaël LESBROS&#10;Bastien OKONSKI" class="credits__names" />
                    <LocalizedLabel key="CreditsLevelDesign" class="credits__role caps" />
                    <ui:Label text="Pierre BIGAUD&#10;Killian GABAUT&#10;Bastien OKONSKI&#10;Jorick REGOTTAZ" class="credits__names" />
                    <LocalizedLabel key="CreditsDevelopment" class="credits__role caps" />
                    <ui:Label text="Florian BOIREAU&#10;Loïs DUPLAIN&#10;Pierre HEBINGER&#10;Raphaël LESBROS&#10;Bastien OKONSKI" class="credits__names" />
                    <LocalizedLabel key="CreditsNarrativeDesign" class="credits__role caps" />
                    <ui:Label text="Raphaël LESBROS&#10;Jorick REGOTTAZ" class="credits__names" />
                    <LocalizedLabel key="CreditsArt3D" class="credits__role caps" />
                    <ui:Label text="Hlafira BOSOVA&#10;Killian GABAUT&#10;Ludivine MARTIN&#10;Jorick REGOTTAZ" class="credits__names" />
                    <LocalizedLabel key="CreditsUxUi" class="credits__role caps" />
                    <ui:Label text="Lucas DANSAC&#10;Jorick REGOTTAZ" class="credits__names" />
                    <LocalizedLabel key="CreditsVfx" class="credits__role caps" />
                    <ui:Label text="Lucas DANSAC" class="credits__names" />
                    <LocalizedLabel key="CreditsSoundDesign" class="credits__role caps" />
                    <ui:Label text="FeathersCrow&#10;Bastien OKONSKI" class="credits__names" />
                    <LocalizedLabel key="CreditsTechnologies" class="credits__role caps" />
                    <ui:Label text="Unity&#10;Audiokinetic Wwise, © 2006-2026 Audiokinetic Inc.&#10;Steamworks.NET&#10;Discord Game SDK" class="credits__names" />
                    <LocalizedLabel key="CreditsThirdPartyAssets" class="credits__role caps" />
                    <ui:Label text="Low Poly Cave Pack&#10;Free Meadows, Emace Art&#10;Melee Warrior Animations, Kevin Iglesias&#10;Forest Pack, Malbers Animations" class="credits__names" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="separator" />
            <SlantedButton name="CloseCredits" key="MenuReturn" class="outline-button panel" corners="TopLeft, BottomRight" />
        </SlantedPanel>
    </ui:VisualElement>

    <ui:VisualElement name="Disclaimer" class="screen stretch dialog">
        <ui:VisualElement class="backdrop stretch backdrop--dark" />
        <SlantedPanel class="dialog__card panel" corners="TopLeft, BottomRight" dots="TopRight">
            <LocalizedLabel key="DisclaimerTitle" class="title caps dialog__title" />
            <LocalizedLabel key="DisclaimerText" class="dialog__text" />
            <SlantedButton name="CloseDisclaimer" key="DisclaimerClose" class="outline-button panel" corners="TopLeft, BottomRight" />
        </SlantedPanel>
    </ui:VisualElement>
</ui:UXML>
