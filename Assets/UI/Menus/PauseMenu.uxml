<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Options" src="Options.uxml" />
    <ui:VisualElement name="Pause" class="screen stretch">
        <ui:VisualElement class="backdrop stretch" />
        <!-- The run so far, filled by UIPause on opening -->
        <SlantedPanel name="RunSummary" class="run-summary panel" corners="TopRight, BottomLeft" picking-mode="Ignore">
            <LocalizedLabel key="PauseSummaryTitle" class="run-summary__title caps" />
            <ui:VisualElement class="accent-line" />
            <ui:Label name="SummaryRooms" class="run-summary__line run-summary__line--first" />
            <ui:Label name="SummaryKills" class="run-summary__line" />
            <ui:Label name="SummaryTime" class="run-summary__line" />
            <ui:Label name="SummaryScore" class="run-summary__line run-summary__score" />
            <!-- The run's seed and its copy button, and whether the run is unranked (SeedTag) -->
            <SeedTag />
        </SlantedPanel>
        <SlantedPanel class="side-panel panel" corners="TopLeft">
            <ui:VisualElement name="Main" class="view pause">
                <LocalizedLabel key="PauseTitle" class="pause__title caps" />
                <ui:VisualElement class="accent-line" />
                <ui:VisualElement class="pause__list menu-list">
                    <MenuButton name="Resume" key="PauseMenuReturnToGame" class="menu-button--primary" />
                    <ui:VisualElement class="separator separator--group" />
                    <MenuButton name="OpenOptions" key="MenuOptions" />
                    <MenuButton name="NewRun" key="PauseMenuNewRun" />
                    <MenuButton name="MainMenu" key="PauseMenuMainMenu" />
                    <MenuButton name="Quit" key="PauseMenuQuitGame" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Instance template="Options" class="view hidden" />
        </SlantedPanel>
        <!-- The seed again, for the Classic's sheet, which hides the summary (shown by ClassicMenus.uss only) -->
        <SeedTag class="seed-tag--classic" />
    </ui:VisualElement>
</ui:UXML>
