/* In game HUD: the status, action and timeline panels at the bottom, the skills bar, the bag button, the minimap
   and the popups over the game */

:root {
    --color-energy-empty: #9D9BBA;
    --color-health-trail: #F4B3C2;
    --color-selected: #7459D8;
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Panel of the bottom row. The HUD and the inventory share three columns: 600 points on the sides, 420 in the
   middle, 48 from the edges */
.hud-panel {
    position: absolute;
    bottom: 112px;
    height: 76px;
    --cut-size: 18;
}

/* Health, shield and energy of the player */
.hud-status {
    left: 48px;
    width: 600px;
    padding: 12px 32px 0 36px;
}

.health-bar {
    height: 28px;
}

.health-bar__fill,
.health-bar__trail,
.health-bar__shield {
    position: absolute;
    left: 0;
    top: 2px;
    bottom: 2px;
    --cut-size: 22;
    /* The three bars leave the same room for the fill's shadow, so that their shapes match */
    --shadow-offset: 2;
    --shadow-color: rgba(0, 0, 0, 0);
    transition-property: width;
    transition-timing-function: ease-out-cubic;
}

.health-bar__fill {
    width: 100%;
    --fill-color: var(--color-health);
    --shadow-color: var(--sharp-shadow);
    transition-duration: 0.3s;
}

/* The bar flashes white when the player is hit */
.health-bar--hit > .health-bar__fill {
    --fill-color: #FFFFFF;
}

/* The health lost fades out behind the bar */
.health-bar__trail {
    width: 100%;
    --fill-color: var(--color-health-trail);
    transition-duration: 0.6s;
    transition-delay: 0.3s;
}

.health-bar__shield {
    width: 0;
    --fill-color: var(--color-shield);
    transition-duration: 0.3s;
}

.health-bar__text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-font-definition: var(--font-display);
    font-size: 17px;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 var(--sharp-shadow);
}

.energy {
    flex-direction: row;
    margin-top: 8px;
    height: 16px;
}

.energy-cell {
    width: 40px;
    height: 16px;
    margin-right: 3px;
    --cut-size: 16;
    --fill-color: var(--color-energy);
    --shadow-offset: 2;
    --shadow-color: var(--sharp-shadow);
    transition-property: scale, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

/* The energy an action would cost */
.energy-cell--previewed {
    --fill-color: var(--color-energy-empty);
    opacity: 0.8;
}

.energy-cell--empty {
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: var(--color-energy-empty);
    --line-width: 1.5;
    --shadow-offset: 0;
    scale: 0.85 0.85;
    opacity: 0.7;
}

/* Button ending the turn, or showing that the player explores or deploys */
.hud-action {
    left: 50%;
    width: 420px;
    translate: -50% 0;
    -unity-font-definition: var(--font-display);
    font-size: 24px;
    color: var(--color-text);
    text-shadow: 2px 2px 0 var(--sharp-shadow);
    transition-property: color, scale;
    transition-duration: 0.15s, 0.12s;
    transition-timing-function: ease-out-back;
}

/* The player's turn starts */
.hud-action.pulse {
    scale: 1.06 1.06;
    color: var(--color-accent);
}

.hud-action:hover:enabled {
    color: var(--color-accent);
    --line-color: var(--color-accent);
    --fill-color: var(--panel-fill-hover);
}

.hud-action:active:enabled {
    scale: 0.97 0.97;
}

.hud-action.waiting {
    color: var(--color-muted);
    --line-color: rgba(255, 255, 255, 0.4);
}

/* Turn order: during a combat, the entity playing stands out */
.hud-timeline {
    right: 48px;
    width: 600px;
    padding: 0 28px;
    flex-direction: row;
    align-items: center;
}

.timeline-item {
    width: 60px;
    height: 46px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.2s;
}

.in-combat > .timeline-item {
    opacity: 0.5;
}

.in-combat > .timeline-item.current {
    opacity: 1;
    scale: 1.12 1.12;
}

.timeline-item__marker {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: -3px;
    height: 2px;
    background-color: var(--color-accent);
    visibility: hidden;
}

.in-combat > .timeline-item.current > .timeline-item__marker {
    visibility: visible;
}

/* Stats of the hovered entity, above it */
.timeline-item__stats {
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 220px;
    margin-bottom: 24px;
    padding: 14px 20px;
    translate: -50% 6px;
    font-size: 16px;
    color: #CCCCCC;
    white-space: nowrap;
    --cut-size: 16;
}

.timeline-item:hover > .timeline-item__stats {
    opacity: 1;
    visibility: visible;
    translate: -50% 0;
}

.timeline-item__name {
    -unity-font-definition: var(--font-display);
    font-size: 20px;
    color: var(--color-text);
    margin-bottom: 6px;
}

/* Skills of the artifacts in the inventory */
.skills {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    height: 84px;
    flex-direction: row;
    justify-content: center;
}

/* Skill of an artifact (SkillSlot): it pops in, lifts when hovered */
.skill {
    width: 84px;
    height: 84px;
    margin: 0 14px;
    scale: 0.5 0.5;
    opacity: 0;
    --cut-size: 42;
    --line-width: 1.5;
    --backdrop-blur: 12;
    transition-property: scale, opacity, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-back;
}

.skill--shown {
    scale: 1 1;
    opacity: 1;
}

.skill--shown:hover {
    scale: 1.08 1.08;
    translate: 0 -4px;
    --line-color: var(--color-accent);
}

.skill--shown:active {
    scale: 0.95 0.95;
}

.skill--cooldown > .skill__icon {
    opacity: 0.3;
}

.skill.selected {
    --fill-color: var(--color-selected);
    --line-color: var(--color-text);
}

.skill--shown.unusable {
    opacity: 0.45;
}

/* Selected while it can't be cast */
.skill--shown.skill--refused {
    opacity: 1;
    --line-color: var(--color-accent);
}

.skill--refused > .skill__cooldown {
    color: var(--color-accent);
}

.skill__icon {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.skill__cooldown {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: var(--font-display);
    font-size: 32px;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 var(--sharp-shadow);
}

/* Energy cost, level with the diamond's top corner and overlapping its left side */
.skill__cost {
    position: absolute;
    left: -18px;
    top: 0;
}

/* Effects of the hovered skill */
.tooltip {
    position: absolute;
    left: 50%;
    bottom: 204px;
    max-width: 480px;
    padding: 10px 40px;
    translate: -50% 6px;
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    --cut-size: 22;
}

.tooltip.shown {
    translate: -50% 0;
}

/* Opens the inventory */
.hud-bag {
    position: absolute;
    right: 48px;
    bottom: 36px;
    width: 52px;
    height: 52px;
    padding: 0;
    -unity-font-definition: var(--font-display);
    font-size: 14px;
    color: var(--color-text);
    --line-width: 1.5;
    --backdrop-blur: 12;
    transition-property: color, scale;
    transition-duration: 0.15s, 0.1s;
}

.hud-bag:hover:enabled {
    color: var(--color-accent);
    --line-color: var(--color-accent);
    --fill-color: var(--panel-fill-hover);
}

.hud-bag:active:enabled {
    scale: 0.94 0.94;
}

/* Name and stats of the hovered enemy, centered on the position set by EntityInfoPanel */
.entity-info {
    position: absolute;
    width: 280px;
    height: 88px;
    padding: 10px 56px;
    translate: -50% -50%;
    scale: 0.94 0.94;
    justify-content: center;
    align-items: center;
    --cut-size: 44;
}

.entity-info.shown {
    scale: 1 1;
}

.entity-info .unity-label {
    -unity-font-definition: var(--font-display);
    font-size: 17px;
    padding: 0 4px;
}

/* Drawn as a border, like the separators of the menus */
.entity-info__separator {
    align-self: stretch;
    margin: 5px 0;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.6);
}

.entity-info__stats {
    flex-direction: row;
}

.entity-info__health {
    color: var(--color-accent);
}

.entity-info__movement {
    color: #20D15F;
}

/* Attack and defense buffs of the player, under its status */
.status-effects {
    position: absolute;
    left: 84px;
    bottom: 28px;
    flex-direction: row;
}

.status-effect {
    width: 56px;
    height: 56px;
    margin-right: 26px;
    opacity: 0;
    scale: 0.6 0.6;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.status-effect.up,
.status-effect.down {
    opacity: 1;
    scale: 1 1;
}

.status-effect--attack.up {
    background-image: url("/Assets/Art/UI/Buff/AttackUp.png");
}

.status-effect--attack.down {
    background-image: url("/Assets/Art/UI/Buff/AttackDown.png");
}

.status-effect--defense.up {
    background-image: url("/Assets/Art/UI/Buff/DefenseUp.png");
}

.status-effect--defense.down {
    background-image: url("/Assets/Art/UI/Buff/DefenseDown.png");
}

.status-effect > .unity-label {
    position: absolute;
    right: -12px;
    bottom: -4px;
    -unity-font-definition: var(--font-display);
    font-size: 18px;
}

/* Damage taken, over the entity: it pops, then rises while fading out */
.popup {
    position: absolute;
    translate: -50% -50%;
    scale: 0 0;
    -unity-font-definition: var(--font-display);
    font-size: 36px;
    color: var(--color-text);
    text-shadow: 3px 3px 0 var(--sharp-shadow);
    transition-property: scale, opacity, translate;
    transition-duration: 0.23s, 0.2s, 0.2s;
    transition-timing-function: ease-out-back, linear, ease-in-cubic;
}

.popup--shown {
    scale: 1 1;
}

.popup--fading {
    opacity: 0;
    translate: -50% -120%;
}

/* The health lost by the player */
.popup--player-hurt {
    color: var(--color-health);
}

.popup--heavy {
    font-size: 52px;
}

/* The damage the armor took */
.popup--blocked {
    font-size: 26px;
    color: var(--color-shield);
}

.popup--heal {
    color: var(--color-victory);
}

.popup--armor {
    font-size: 30px;
    color: var(--color-shield);
}

.popup--status {
    font-size: 24px;
}

.popup--status.popup--attack {
    color: var(--color-attack);
}

.popup--status.popup--defense {
    color: var(--color-shield);
}

.popup--status.down {
    color: var(--color-muted);
}

.popup--score {
    font-size: 26px;
    color: var(--color-attack);
}

.popup--score.popup--fading {
    translate: -50% -200%;
}

/* The steps of a combat, announced in the middle of the screen: it slides in, then fades out */
.banner {
    position: absolute;
    top: 30%;
    left: 50%;
    padding: 14px 72px;
    translate: -50% 0;
    -unity-font-definition: var(--font-display);
    font-size: 44px;
    color: var(--color-text);
    text-shadow: 3px 3px 0 var(--sharp-shadow);
    --cut-size: 22;
    opacity: 0;
    translate: -40% 0;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}

.banner.shown {
    opacity: 1;
    translate: -50% 0;
}

.banner--combat,
.banner--enemy {
    color: var(--color-accent);
    --line-color: var(--color-accent);
}

.banner--victory {
    color: var(--color-victory);
    --line-color: var(--color-victory);
}

/* The boss's health, at the top of the screen in its room */
.boss-bar {
    position: absolute;
    top: 40px;
    left: 50%;
    width: 760px;
    padding: 10px 36px 16px 36px;
    translate: -50% 0;
    --cut-size: 18;
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, visibility;
    transition-duration: 0.3s;
}

.boss-bar.shown {
    opacity: 1;
    visibility: visible;
}

.boss-bar__name {
    -unity-font-definition: var(--font-display);
    font-size: 22px;
    -unity-text-align: middle-center;
    color: var(--color-accent);
    text-shadow: 2px 2px 0 var(--sharp-shadow);
    margin-bottom: 6px;
}

.boss-bar__track {
    position: relative;
}

/* The health at which the boss changes phase */
.boss-bar__phase {
    position: absolute;
    top: 60%;
    bottom: -6px;
    width: 3px;
    translate: -50% 0;
    background-color: var(--color-text);
}

.boss-bar__phase.hidden {
    display: none;
}

/* Map of the visited rooms, centered on the current one */
.minimap {
    position: absolute;
    top: 48px;
    right: 48px;
    width: 220px;
    height: 220px;
}

.minimap__view {
    position: absolute;
    left: 1px;
    top: 1px;
    right: 1px;
    bottom: 1px;
    overflow: hidden;
}

/* The center of the map: the rooms are placed from it, the grid sliding when the player changes room */
.minimap__rooms {
    position: absolute;
    left: 50%;
    top: 50%;
    transition-property: translate;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-cubic;
}

.minimap-room {
    position: absolute;
    width: 22px;
    height: 22px;
    visibility: hidden;
    background-color: rgba(20, 20, 24, 0.85);
    border-width: 1.5px;
    border-color: #707070;
}

.minimap-room.revealed {
    visibility: visible;
}

.minimap-room.visited {
    border-color: rgba(255, 255, 255, 0.9);
}

.minimap-room.current {
    border-color: #1ECC55;
    border-width: 2px;
}

.minimap-room > VisualElement {
    flex-grow: 1;
    margin: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.minimap-room--treasure > VisualElement {
    background-image: url("/Assets/Art/UI/Minimap/TreasureIcon.png");
}

.minimap-room--boss > VisualElement {
    background-image: url("/Assets/Art/UI/Minimap/BossIcon.png");
}

.minimap-room--antechamber > VisualElement {
    background-image: url("/Assets/Art/UI/Minimap/AntechamberIcon.png");
}

/* Black screen between two rooms, over the whole HUD */
.fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #000000;
}
