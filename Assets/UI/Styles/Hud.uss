/* In game HUD: the status, action and timeline panels at the bottom, the skills bar, the bag button, the minimap
   and the popups over the game */

/* Panel of the bottom row. The HUD and the inventory share three columns: 600 points on the sides, 420 in the
   middle, 48 from the edges */
.hud-panel {
    position: absolute;
    bottom: 112px;
    height: 76px;
    --cut-size: 18;
}

/* Health, shield and energy of the player */
.hud-status {
    left: var(--space-edge);
    width: var(--column-side);
    padding: 12px 32px 0 36px;
}

.health-bar {
    height: 28px;
}

.health-bar__fill,
.health-bar__trail,
.health-bar__preview,
.health-bar__shield {
    position: absolute;
    left: 0;
    top: 2px;
    bottom: 2px;
    --cut-size: 22;
    /* The three bars leave the same room for the fill's shadow, so that their shapes match */
    --shadow-offset: 2;
    --shadow-color: rgba(0, 0, 0, 0);
    transition-property: width;
    transition-timing-function: ease-out-cubic;
}

.health-bar__fill {
    width: 100%;
    --fill-color: var(--color-health);
    --shadow-color: var(--sharp-shadow);
    transition-duration: var(--duration-slow);
}

/* The bar flashes white when the player is hit */
.health-bar--hit > .health-bar__fill {
    --fill-color: var(--color-hit-flash);
}

/* The health lost fades out behind the bar */
.health-bar__trail {
    width: 100%;
    --fill-color: var(--color-health-trail);
    transition-duration: 0.6s;
    /* Once the fill has shrunk */
    transition-delay: var(--duration-slow);
}

/* The health an action would take, blinking at the end of the fill (HealthBar.Preview) */
.health-bar__preview {
    width: 0;
    --fill-color: var(--color-hit-flash);
    --shadow-offset: 0;
    opacity: 0.85;
    transition-property: opacity;
    transition-duration: var(--duration-fast);
}

.health-bar__preview--dim {
    opacity: 0.3;
}

.health-bar__shield {
    width: 0;
    --fill-color: var(--color-shield);
    transition-duration: var(--duration-slow);
}

.health-bar__text {
    -unity-font-definition: var(--font-display);
    font-size: 17px;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 var(--sharp-shadow);
}

/* As wide as its cells, so that its tooltip shows over them only */
.energy {
    align-self: flex-start;
    flex-direction: row;
    margin-top: 8px;
    height: 16px;
}

.energy-cell {
    width: 40px;
    height: 16px;
    margin-right: 3px;
    --cut-size: 16;
    --fill-color: var(--color-energy);
    --shadow-offset: 2;
    --shadow-color: var(--sharp-shadow);
    transition-property: scale, opacity;
    transition-duration: var(--duration-medium);
    transition-timing-function: ease-out-back;
}

/* The energy an action would cost */
.energy-cell--previewed {
    --fill-color: var(--color-energy-empty);
    opacity: 0.8;
}

.energy-cell--empty {
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: var(--color-energy-empty);
    --line-width: var(--panel-line-width-bold);
    --shadow-offset: 0;
    scale: 0.85 0.85;
    opacity: 0.7;
}

/* An artifact costs more energy than is left: the gauge shakes (RefuseShake), its empty cells in the accent color */
.energy--refused > .energy-cell--empty {
    --line-color: var(--color-accent);
    opacity: 1;
}

/* Button ending the turn, or showing that the player explores or deploys */
.hud-action {
    left: 50%;
    width: var(--column-middle);
    translate: -50% 0;
    font-size: var(--font-size-lg);
    text-shadow: 2px 2px 0 var(--sharp-shadow);
    transition-duration: var(--duration-fast), 0.12s;
    transition-timing-function: ease-out-back;
}

/* The player's turn starts */
.hud-action.pulse {
    scale: 1.06 1.06;
    color: var(--color-accent);
}

/* No energy left: the button beats until the turn ends (Hud.RefreshEndTurnBeat) */
.hud-action.beat {
    scale: 1.04 1.04;
    color: var(--color-accent);
    --line-color: var(--color-accent);
}

.hud-action.waiting {
    color: var(--color-muted);
    --line-color: rgba(255, 255, 255, 0.4);
}

/* Turn order: during a combat, the entity playing stands out */
.hud-timeline {
    right: var(--space-edge);
    width: var(--column-side);
    padding: 0 28px;
    flex-direction: row;
    align-items: center;
}

.timeline-item {
    width: 60px;
    height: 46px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: var(--duration-medium);
}

.in-combat > .timeline-item {
    opacity: 0.5;
}

.in-combat > .timeline-item.current {
    opacity: 1;
    scale: 1.12 1.12;
}

.timeline-item__marker {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: -3px;
    height: 2px;
    background-color: var(--color-accent);
    visibility: hidden;
}

.in-combat > .timeline-item.current > .timeline-item__marker {
    visibility: visible;
}

/* Skills of the artifacts in the inventory */
.skills {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    height: 84px;
    flex-direction: row;
    justify-content: center;
}

/* Skill of an artifact (SkillSlot): it pops in, lifts when hovered */
.skill {
    width: 84px;
    height: 84px;
    margin: 0 14px;
    scale: 0.5 0.5;
    opacity: 0;
    --cut-size: 42;
    --line-width: var(--panel-line-width-bold);
    --backdrop-blur: 12;
    transition-property: scale, opacity, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-back;
}

.skill--shown {
    scale: 1 1;
    opacity: 1;
}

.skill--shown:hover {
    scale: 1.08 1.08;
    translate: 0 -4px;
    --line-color: var(--color-accent);
}

.skill--shown:active {
    scale: 0.95 0.95;
}

/* The casts of the skill waiting in the queue, on the diamond's right corner */
.skill__queued {
    position: absolute;
    right: -20px;
    top: 30px;
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-md);
    color: var(--color-energy-text);
    text-shadow: 1px 1px 0 var(--sharp-shadow);
}

.skill--queued {
    --line-color: var(--color-energy-text);
}

.skill--cooldown > .skill__icon {
    opacity: 0.3;
}

.skill.selected {
    --fill-color: var(--color-selected);
    --line-color: var(--color-text);
}

.skill--shown.unusable {
    opacity: 0.45;
}

/* The key selecting the skill, under the diamond's bottom corner */
.skill__key {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -22px;
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-xs);
    -unity-text-align: middle-center;
    color: var(--color-muted);
    text-shadow: 1px 1px 0 var(--sharp-shadow);
}

/* The end of turn waits for a second press */
.hud-action.confirm {
    color: var(--color-warning);
    --line-color: var(--color-warning);
}

/* Selected while it can't be cast */
.skill--shown.skill--refused {
    opacity: 1;
    --line-color: var(--color-accent);
}

.skill--refused > .skill__cooldown {
    color: var(--color-accent);
}

.skill__icon {
    -unity-background-scale-mode: scale-to-fit;
}

.skill__cooldown {
    -unity-font-definition: var(--font-display);
    font-size: 32px;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 var(--sharp-shadow);
}

/* Energy cost, level with the diamond's top corner and overlapping its left side */
.skill__cost {
    position: absolute;
    left: -18px;
    top: 0;
}

/* Effects of the hovered skill */
.tooltip {
    position: absolute;
    left: 50%;
    bottom: 204px;
    max-width: 480px;
    padding: 10px 40px;
    translate: -50% 6px;
    font-size: var(--font-size-sm);
    white-space: normal;
    -unity-text-align: middle-center;
    --cut-size: 22;
}

.tooltip.shown {
    translate: -50% 0;
}

/* What the hovered status effect does, right of the status effects; its line in the buff or debuff color */
.tooltip--status {
    left: 260px;
    bottom: 22px;
    max-width: 400px;
    padding: 8px 32px;
    translate: -6px 0;
    -unity-text-align: middle-left;
    --cut-size: 18;
}

.tooltip--status.shown {
    translate: 0 0;
}

.tooltip--status.buff {
    --line-color: var(--color-buff);
}

.tooltip--status.debuff {
    --line-color: var(--color-debuff);
}

/* Next to the hovered stat or timeline item, placed by HudTooltip (left and top) */
.tooltip--anchored {
    left: 0;
    translate: 0 6px;
}

.tooltip--anchored.shown {
    translate: 0 0;
}

/* Opens the inventory */
.hud-bag {
    position: absolute;
    right: var(--space-edge);
    bottom: 36px;
    width: 52px;
    height: 52px;
    padding: 0;
    font-size: var(--font-size-xs);
    --line-width: var(--panel-line-width-bold);
    --backdrop-blur: 12;
}

.hud-bag:active:enabled {
    scale: 0.94 0.94;
}

/* Name and stats of the hovered enemy, centered on the position set by EntityInfoPanel */
.entity-info {
    position: absolute;
    width: 280px;
    min-height: 88px;
    padding: 10px 56px;
    translate: -50% -50%;
    scale: 0.94 0.94;
    justify-content: center;
    align-items: center;
    --cut-size: 44;
}

.entity-info.shown {
    scale: 1 1;
}

.entity-info .unity-label {
    -unity-font-definition: var(--font-display);
    font-size: 17px;
    padding: 0 4px;
}

.entity-info .separator {
    margin: 5px 0;
}

.entity-info__stats {
    flex-direction: row;
}

.entity-info__health {
    color: var(--color-accent);
}

.entity-info__movement {
    color: var(--color-movement);
}

.entity-info__armor {
    color: var(--color-shield);
}

.entity-info .entity-info__effects {
    font-size: 13px;
    color: var(--color-attack);
    margin-top: 2px;
}

/* The health the selected artifact would take from each target */
.damage-preview {
    position: absolute;
    translate: -50% -50%;
    transition-property: scale;
    transition-duration: var(--duration-medium);
    transition-timing-function: ease-out-cubic;
    -unity-font-definition: var(--font-display);
    font-size: 26px;
    -unity-text-align: middle-center;
    color: var(--color-text);
    text-shadow: 2px 2px 0 var(--sharp-shadow);
}

/* The order of the queued casts, over their targets */
.queued-cast {
    position: absolute;
    translate: -50% -50%;
    padding: 0 8px;
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-lg);
    -unity-text-align: middle-center;
    color: var(--color-text);
    background-color: var(--color-selected);
    text-shadow: 2px 2px 0 var(--sharp-shadow);
}

.damage-preview--may-kill {
    color: var(--color-warning);
}

.damage-preview--lethal {
    color: var(--color-accent);
}

/* A lethal or maybe lethal preview beats (DamagePreview) */
.damage-preview--may-kill.damage-preview--beat,
.damage-preview--lethal.damage-preview--beat {
    scale: 1.15 1.15;
}

/* Attack and defense buffs of the player, under its status */
.status-effects {
    position: absolute;
    left: 84px;
    bottom: 28px;
    flex-direction: row;
}

.status-effect {
    width: 56px;
    height: 56px;
    margin-right: 26px;
    opacity: 0;
    scale: 0.6 0.6;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: var(--duration-fade);
    transition-timing-function: ease-out-back;
}

.status-effect.up,
.status-effect.down {
    opacity: 1;
    scale: 1 1;
}

.status-effect--attack.up {
    background-image: url("/Assets/Art/UI/Buff/AttackUp.png");
}

.status-effect--attack.down {
    background-image: url("/Assets/Art/UI/Buff/AttackDown.png");
}

.status-effect--defense.up {
    background-image: url("/Assets/Art/UI/Buff/DefenseUp.png");
}

.status-effect--defense.down {
    background-image: url("/Assets/Art/UI/Buff/DefenseDown.png");
}

.status-effect > .unity-label {
    position: absolute;
    right: -12px;
    bottom: -4px;
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-md);
}

/* Damage taken, over the entity: it pops, then rises while fading out */
.popup {
    position: absolute;
    translate: -50% -50%;
    scale: 0 0;
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    text-shadow: 3px 3px 0 var(--sharp-shadow);
    transition-property: scale, opacity, translate;
    transition-duration: 0.23s, var(--duration-medium), var(--duration-medium);
    transition-timing-function: ease-out-back, linear, ease-in-cubic;
}

.popup--shown {
    scale: 1 1;
}

.popup--fading {
    opacity: 0;
    translate: -50% -120%;
}

/* The health lost by the player */
.popup--player-hurt {
    color: var(--color-health);
}

/* The lethal hit; the popups' scale grows with the health lost (CombatPopups) */
.popup--lethal {
    color: var(--color-accent);
}

/* The damage the armor took */
.popup--blocked {
    font-size: 26px;
    color: var(--color-shield);
}

.popup--heal {
    color: var(--color-heal);
}

.popup--armor {
    font-size: 30px;
    color: var(--color-shield);
}

.popup--status {
    font-size: var(--font-size-lg);
}

.popup--status.popup--attack {
    color: var(--color-attack);
}

.popup--status.popup--defense {
    color: var(--color-shield);
}

.popup--status.down {
    color: var(--color-muted);
}

.popup--score {
    font-size: 26px;
    color: var(--color-attack);
}

.popup--score.popup--fading {
    translate: -50% -200%;
}

/* The steps of a combat, announced in the middle of the screen: it slides in, then fades out */
.banner {
    position: absolute;
    top: 50%;
    left: 50%;
    padding: 14px 72px;
    -unity-font-definition: var(--font-display);
    font-size: 44px;
    color: var(--color-text);
    text-shadow: 3px 3px 0 var(--sharp-shadow);
    --cut-size: 22;
    opacity: 0;
    translate: -40% -50%;
    transition-property: opacity, translate;
    transition-duration: var(--duration-fade);
    transition-timing-function: ease-out-cubic;
}

.banner.shown {
    opacity: 1;
    translate: -50% -50%;
}

.banner--combat,
.banner--enemy {
    color: var(--color-accent);
    --line-color: var(--color-accent);
}

.banner--victory {
    color: var(--color-victory);
    --line-color: var(--color-victory);
}

/* The boss's health, at the top of the screen in its room */
.boss-bar {
    position: absolute;
    top: 40px;
    left: 50%;
    width: 760px;
    padding: 10px 36px 16px 36px;
    translate: -50% 0;
    --cut-size: 18;
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, visibility;
    transition-duration: var(--duration-slow);
}

.boss-bar.shown {
    opacity: 1;
    visibility: visible;
}

.boss-bar__name {
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-base);
    -unity-text-align: middle-center;
    color: var(--color-accent);
    text-shadow: 2px 2px 0 var(--sharp-shadow);
    margin-bottom: 6px;
}

.boss-bar__track {
    position: relative;
}

/* The health at which the boss changes phase */
.boss-bar__phase {
    position: absolute;
    top: 60%;
    bottom: -6px;
    width: 3px;
    translate: -50% 0;
    background-color: var(--color-text);
}

/* Map of the visited rooms, centered on the current one */
.minimap {
    position: absolute;
    top: var(--space-edge);
    right: var(--space-edge);
    width: 220px;
    height: 220px;
}

.minimap__view {
    position: absolute;
    left: 1px;
    top: 1px;
    right: 1px;
    bottom: 1px;
    overflow: hidden;
}

/* The center of the map: the rooms are placed from it, the grid sliding when the player changes room */
.minimap__rooms {
    position: absolute;
    left: 50%;
    top: 50%;
    transition-property: translate;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-cubic;
}

.minimap-room {
    position: absolute;
    width: 22px;
    height: 22px;
    visibility: hidden;
    background-color: rgba(20, 20, 24, 0.85);
    border-width: 1.5px;
    border-color: #707070;
}

.minimap-room.revealed {
    visibility: visible;
}

.minimap-room.visited {
    border-color: rgba(255, 255, 255, 0.9);
}

.minimap-room.current {
    border-color: var(--color-valid);
    border-width: 2px;
}

.minimap-room > VisualElement {
    flex-grow: 1;
    margin: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.minimap-room--treasure > VisualElement {
    background-image: url("/Assets/Art/UI/Minimap/TreasureIcon.png");
}

.minimap-room--boss > VisualElement {
    background-image: url("/Assets/Art/UI/Minimap/BossIcon.png");
}

.minimap-room--antechamber > VisualElement {
    background-image: url("/Assets/Art/UI/Minimap/AntechamberIcon.png");
}
