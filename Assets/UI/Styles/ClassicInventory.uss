/*
 * The Classic edition's look of the inventory (docs/features/editions.md), after Classic.uss: its panels, grids, character sheet, artifact details and pieces.
 */

/* ---- Inventory (the classic class is on #Inventory) ---- */

/* The inventory shows at once and its panels scale from 0 to 1 over 0.125 s linearly, as the original's */
.classic.inventory {
    transition-duration: 0s;
}

.classic .inventory-panel {
    scale: 0 0;
    transition-duration: 0.125s;
    transition-timing-function: linear;
}

.classic.open .inventory-panel {
    scale: 1 1;
}

/* The original's panels (UI.prefab, InventoryMenu): the character sheet (Character Tab) 607 by 701 at 57, 75, or the
   chest (Inventory Tab) at 58, 74; the artifact's details (Artefact Info Tab) 604 by 694 at 638, 80; the inventory
   (Inventory Tab) 607 by 701 at 1257, 74. Their children are placed from the panels' top left corners */
.classic .inventory-panel {
    padding: 0;
    align-items: flex-start;
    translate: 0 0;
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.classic #PlayerInfo {
    left: 57px;
    top: 75px;
    width: 607px;
    height: 701px;
    background-image: url("/Assets/Art/Classic/UI/Character Tab.png");
}

.classic #Chest {
    left: 58px;
    top: 74px;
    width: 607px;
    height: 701px;
    background-image: url("/Assets/Art/Classic/UI/Inventory Tab.png");
}

.classic #Description {
    left: 638px;
    top: 80px;
    width: 604px;
    height: 694px;
    background-image: url("/Assets/Art/Classic/UI/Artefact Info Tab.png");
}

.classic #PlayerInventory {
    left: 1257px;
    right: auto;
    top: 74px;
    width: 607px;
    height: 701px;
    background-image: url("/Assets/Art/Classic/UI/Inventory Tab.png");
}

/* The titles in Kallisto 30 bold italic, the subtitles in white Bicyclette 20, centered on the heights of the original's */
.classic .inventory-panel > .inventory-panel__title {
    position: absolute;
    left: 0;
    right: 0;
    height: 40px;
    font-size: 30px;
    -unity-font-style: bold-and-italic;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.classic .inventory-panel > .inventory-panel__subtitle {
    position: absolute;
    left: 0;
    right: 0;
    height: 30px;
    margin: 0;
    font-size: 20px;
    color: var(--color-text);
}

.classic #PlayerInventory > .inventory-panel__title,
.classic #Chest > .inventory-panel__title {
    top: 36.7px;
}

.classic #PlayerInventory > .inventory-panel__subtitle,
.classic #Chest > .inventory-panel__subtitle {
    top: 75.5px;
}

/* 23.6 right of the middle */
.classic #Description > .inventory-panel__title {
    left: 47.2px;
    top: 30px;
}

.classic #Description > .inventory-panel__subtitle {
    left: 47.2px;
    top: 69.7px;
}

/* The explorer's name in 27.4, the subtitle in 16 */
.classic #PlayerInfo > .inventory-panel__title {
    top: 48px;
    font-size: 27.4px;
}

.classic #PlayerInfo > .inventory-panel__subtitle {
    top: 85px;
    font-size: 16px;
}

/* The grids: the original's cells were 90 points, ours stay 80 (a scaled grid would shift the drag and drop): the grid is
   centered in the original's 450 point area, 79, 143 into the panel */
.classic .inventory-panel > .inventory-grid {
    position: absolute;
    left: 104.2px;
    top: 167.7px;
    margin: 0;
}

/* The character sheet: the portrait 311 by 408 at -2, 105; the stats and feats from 306, their headers in 17.5 upright
   over a white line and their lines in light grey 15 upright every 23.6 points (as the original's screenshots show them); the zone's title (18 bold italic) and text (Bicyclette 15)
   at 76, 513 and 75, 546; the score in 18 bold italic at 393, 660 */
.classic .player-info {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    height: auto;
}

.classic .player-info__portrait {
    position: absolute;
    left: -2px;
    top: 105px;
    width: 311px;
    height: 408px;
    background-image: url("/Assets/Art/Classic/UI/Character.png");
}

.classic .player-info__stats {
    position: absolute;
    left: 306px;
    top: 125.5px;
    width: 287px;
    margin: 0;
}

.classic .player-info__header {
    height: 30px;
    margin: 32.5px 0 12px 0;
    padding: 0;
    width: 268px;
    border-bottom-width: 1px;
    border-color: #FFFFFF;
    font-size: 17.5px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.classic .unity-label.player-info__line {
    height: 23.6px;
    margin: 0;
    font-size: 15px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    color: #CCCCCC;
}

.classic .player-info__zone-title {
    position: absolute;
    left: 76px;
    top: 513px;
    width: 341px;
    height: 28px;
    margin: 0;
    font-size: 18px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.classic .player-info__zone-text {
    position: absolute;
    left: 75px;
    top: 546px;
    width: 470px;
    height: 83px;
    margin: 0;
    font-size: 15px;
    color: var(--color-text);
    -unity-text-align: upper-left;
}

.classic .player-info__score {
    left: 393px;
    top: 660px;
    right: auto;
    bottom: auto;
    width: 200px;
    height: 24px;
    font-size: 18px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

/* The pressed artifact: its icon 180 points at 232, 106, no frame; under it the original's cooldown and energy sprite,
   190 by 45 (Artefact CD Energy), the cooldown in black and the cost in white, 20 bold italic, on its ring and its tag;
   the hints in Bicyclette 16 on either side */
.classic .artifact-info__icon {
    position: absolute;
    left: 232px;
    top: 106px;
    width: 180px;
    height: 180px;
    margin: 0;
    border-width: 0;
}

.classic .artifact-info__cooldown {
    left: -2px;
    top: 137px;
    bottom: auto;
    width: 190px;
    height: 45px;
    translate: 0 0;
    justify-content: flex-start;
    align-items: flex-start;
}

.classic .artifact-info__cooldown-disc {
    display: none;
}

.classic .artifact-info__cooldown-ring {
    background-image: url("/Assets/Art/Classic/UI/Artefact CD Energy.png");
    background-size: 100% 100%;
    background-position-x: left 0;
}

.classic .artifact-info__cooldown-value {
    position: absolute;
    left: 0;
    top: 3px;
    width: 39px;
    height: 41px;
    margin: 0;
    font-size: 20px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
}

.classic .artifact-info__cost {
    left: 119px;
    top: 149px;
    right: auto;
    bottom: auto;
    width: 68px;
    height: 23px;
    translate: 0 0;
    background-image: none;
}

.classic .artifact-info__cost > .cost-tag__value {
    font-size: 20px;
    -unity-font-style: bold-and-italic;
}

.classic .artifact-info__hint {
    width: 98px;
    height: 19px;
    font-size: 16px;
}

.classic .artifact-info__cooldown > .artifact-info__hint {
    top: 14px;
}

.classic .artifact-info__cost > .artifact-info__hint {
    top: 2px;
}

/* The name and effects: 338 point wide boxes at 154, 324 and 154, 489 without frames, their titles in 20 bold italic
   and their texts in Bicyclette 18, left-aligned */
.classic #Description {
    padding-top: 324px;
}

.classic .artifact-info__box {
    align-self: flex-start;
    width: 338px;
    height: 103px;
    min-height: 0;
    margin: 0 0 62px 154px;
    padding: 2px 4px 0 4px;
    border-width: 0;
}

.classic .artifact-info__box-title {
    height: 26px;
    margin-bottom: 6px;
    font-size: 20px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.classic .artifact-info__box-text {
    font-size: 18px;
    -unity-text-align: upper-left;
}

/* The pieces are neither pressed in the hand nor bounce when put down */
.classic .artifact-piece__body,
.classic .artifact-piece--held > .artifact-piece__body,
.classic .artifact-piece--landing > .artifact-piece__body {
    scale: 1 1;
    transition-duration: 0s;
}

.classic .artifact-piece__icon {
    transition-duration: 0s;
}

/* The inventory slots don't preview where the piece in hand would go */
.classic .inventory-slot--valid,
.classic .inventory-slot--invalid {
    border-color: rgba(255, 255, 255, 0.55);
}

/* No name of the value over the artifact's cost and cooldown */
.classic .artifact-info__hint {
    display: none;
}

/* ---- The pieces read their custom properties on themselves (customStyle doesn't see the inherited ones) ---- */

.classic .artifact-piece {
    --ui-effects: 0;
}

/* The original's pieces: its sprite of each artifact, shape and colors baked in, instead of the drawn piece */
.classic .artifact-piece--has-original {
    --piece-drawn: 0;
}

.classic .artifact-piece--has-original .artifact-piece__cell {
    display: none;
}

.classic .artifact-piece--has-original .artifact-piece__original {
    display: flex;
}

/* The artifact details' panel: the original's sprite keeps its proportions (495 by 694) and starts at 748, as its
   screenshots show it; the texts and the icon keep the panel's 638 */
.classic #Description {
    background-size: 495px 694px;
    background-repeat: no-repeat no-repeat;
    background-position-x: left 110px;
    background-position-y: top 0;
}
