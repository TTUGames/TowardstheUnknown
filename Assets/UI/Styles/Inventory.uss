/* Inventory menu: the character sheet or a chest on the left, the pressed artifact in the middle, the player's grid on the right */

.inventory-panel {
    position: absolute;
    top: 96px;
    height: 720px;
    padding: 32px 40px;
    align-items: center;
    --cut-size: 32;
    scale: 0.94 0.94;
    transition-property: scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
}

/* The panels grow when the inventory opens */
.open .inventory-panel {
    scale: 1 1;
}

.inventory-panel--left {
    left: 48px;
    width: 600px;
}

.inventory-panel--center {
    left: 50%;
    width: 420px;
    translate: -50% 0;
}

.inventory-panel--right {
    right: 48px;
    width: 600px;
}

.inventory-panel__title {
    -unity-font-definition: var(--font-display);
    font-size: 28px;
    -unity-text-align: middle-center;
    text-shadow: 3px 3px 0 var(--sharp-shadow);
}

.inventory-panel__subtitle {
    font-size: 16px;
    color: var(--color-muted);
    margin-bottom: 26px;
    -unity-text-align: middle-center;
}

/* Grid of TetrisInventory: slots and items are placed in points from its top left corner */
.inventory-grid {
    margin-top: 8px;
}

.inventory-slot {
    position: absolute;
    width: 80px;
    height: 80px;
    background-image: url("/Assets/Art/UI/InventorySlot.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.55);
    scale: 0.8 0.8;
}

.inventory-item {
    position: absolute;
    transform-origin: left bottom;
}

/* An artifact's piece (ArtifactPiece): cells in the rarity's surface tone, the icon cut to the shape, an outline */
.artifact-piece__cell {
    position: absolute;
    overflow: hidden;
}

.artifact-piece__icon {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #FFFFFF;
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

/* Scaled around its center: the piece itself turns around its corner */
.artifact-piece__body {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}

/* Turned around the pointer when the held piece swings (ArtifactPiece.PlayTurn) */
.artifact-piece__spin {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Held in the hand: pressed a little */
.artifact-piece--held > .artifact-piece__body {
    scale: 0.9 0.9;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

/* Just put down: starts from the held size, at once, then grows back */
.artifact-piece--landing > .artifact-piece__body {
    scale: 0.9 0.9;
    transition-duration: 0s;
}

/* The item under the pointer, which a press shows and a drag takes */
.inventory-item--hovered .artifact-piece__icon {
    -unity-background-image-tint-color: #FFC9D7;
}


/* While an item is in hand, the slots it would fill */
.inventory-slot--valid {
    -unity-background-image-tint-color: #1ECC55;
}

.inventory-slot--invalid {
    -unity-background-image-tint-color: var(--color-accent);
}

/* The item in hand, over the whole screen */
.inventory__hand {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.inventory__hand > .inventory-item {
    opacity: 0.95;
}

/* Character sheet */
.player-info {
    flex-direction: row;
    align-self: stretch;
    height: 310px;
}

.player-info__portrait {
    width: 220px;
    background-image: url("/Assets/Art/UI/Character.png");
    -unity-background-scale-mode: scale-to-fit;
}

.player-info__stats {
    flex-grow: 1;
    margin-left: 28px;
}

.player-info__header {
    -unity-font-definition: var(--font-display);
    font-size: 16px;
    margin-top: 10px;
    padding-bottom: 5px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.6);
}

.player-info__line {
    -unity-font-definition: var(--font-display);
    font-size: 14px;
    color: #CCCCCC;
    margin: 2px 0;
}

.player-info__zone-title {
    align-self: flex-start;
    -unity-font-definition: var(--font-display);
    font-size: 16px;
    margin-top: 26px;
}

.player-info__zone-text {
    align-self: stretch;
    font-size: 14px;
    white-space: normal;
    color: #CCCCCC;
    margin-top: 6px;
}

.player-info__score {
    position: absolute;
    right: 44px;
    bottom: 24px;
    -unity-font-definition: var(--font-display);
    font-size: 16px;
}

/* Pressed artifact */
.artifact-info__icon {
    width: 160px;
    height: 160px;
    margin-bottom: 36px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.45);
    -unity-background-scale-mode: scale-to-fit;
}

/* The cooldown, centered on the frame's bottom left corner: the ring of the original design's sprite, cropped */
.artifact-info__cooldown {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 44px;
    height: 44px;
    translate: -50% 50%;
    justify-content: center;
    align-items: center;
}

/* Hides the frame's lines under the ring */
.artifact-info__cooldown-disc {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    border-radius: 19px;
    background-color: rgb(14, 16, 24);
}

.artifact-info__cooldown-ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Art/UI/Artefact CD Energy.png");
    background-size: 205px 44px;
    background-position-x: left;
}

.artifact-info__cooldown-value {
    -unity-font-definition: var(--font-display);
    font-size: 18px;
    color: #000000;
    padding: 0;
    margin: 2px 0 0 1px;
}

/* The cost, centered on the frame's bottom right corner */
.artifact-info__cost {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 64px;
    height: 24px;
    --cut-size: 24;
    translate: 50% 50%;
}

.artifact-info__cost > .cost-tag__value {
    font-size: 17px;
}

.artifact-info__cooldown:hover > .artifact-info__hint,
.artifact-info__cost:hover > .artifact-info__hint {
    opacity: 1;
    visibility: visible;
}

/* Name of the value, shown while hovering it */
.artifact-info__hint {
    position: absolute;
    top: 10px;
    width: 110px;
    font-size: 14px;
    white-space: normal;
}

.artifact-info__hint--left {
    right: 100%;
    -unity-text-align: middle-right;
}

.artifact-info__hint--right {
    left: 100%;
    -unity-text-align: middle-left;
}

.artifact-info__box {
    align-self: stretch;
    min-height: 110px;
    margin-bottom: 18px;
    padding: 10px 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
}

.artifact-info__box-title {
    -unity-font-definition: var(--font-display);
    font-size: 18px;
    margin-bottom: 4px;
}

.artifact-info__box-text {
    font-size: 16px;
    white-space: normal;
}
