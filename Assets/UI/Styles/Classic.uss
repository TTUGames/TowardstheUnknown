/*
 * The Classic edition's look (docs/features/editions.md): the same screens as the Anniversary, dressed like the original
 * release. Every rule is under .classic, set on the root of each document by MenuScreen.Setup while the Classic is shown;
 * the custom properties are inherited, so the tokens redefined here reach the whole screen.
 */

.classic {
    /* The original's fonts: Kallisto Medium for the titles and buttons, Bicyclette for the texts */
    --font-display: url("/Assets/TextMesh Pro/Resources/Fonts & Materials/Kallisto/Source/Kallisto Medium.otf");
    --font-body: url("/Assets/TextMesh Pro/Resources/Fonts & Materials/Bicyclette/Source/Bicyclette.ttf");
    -unity-font-definition: var(--font-body);

    /* The original's hover lilac (also the hovered inventory piece); the accent stays the original's pink.
       The buttons' states of the original (UGUI color tints): hovered lilac, pressed light grey, the HUD buttons
       pressed red */
    --color-accent-light: #9D9BBA;
    --classic-hover: #9D9BBA;
    --classic-pressed: #C8C8C8;
    --classic-pressed-hud: #D22F45;

    /* Plain dark panels: no frosted blur, no line, square corners */
    --panel-fill: rgba(8, 9, 14, 0.78);
    --panel-fill-hover: rgba(157, 155, 186, 0.2);
    --panel-line: rgba(255, 255, 255, 0);
    --panel-blur: 0;

    /* No animated filters: the health bar's current and sheen, the inventory pieces' rarity glow */
    --ui-effects: 0;
}

/* The original's plain bar: no trail of the health lost, no flash */
.classic .health-bar__trail {
    display: none;
}

/* The shapes of CutShape become rectangles */
.classic .panel,
.classic .slanted-button,
.classic .outline-button,
.classic .tooltip,
.classic .skill,
.classic .hud-action,
.classic .hud-bag,
.classic .entity-info,
.classic .minimap {
    --cut-size: 0;
    --backdrop-blur: 0;
    --shadow-offset: 0;
}

.classic .dot {
    display: none;
}

/* The original's sprites, stretched on the elements they dressed */
.classic .hud-action,
.classic .hud-bag,
.classic .entity-info,
.classic .tooltip,
.classic .skill,
.classic .minimap {
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.classic .hud-action {
    background-image: url("/Assets/Art/Classic/UI/End Turn Button.png");
    -unity-font-definition: var(--font-display);
}

.classic .hud-bag {
    background-image: url("/Assets/Art/Classic/UI/Bag Button.png");
}

.classic .entity-info {
    background-image: url("/Assets/Art/Classic/UI/Hover_Entity.png");
}

.classic .tooltip {
    background-image: url("/Assets/Art/Classic/UI/Hover Artefact Info.png");
}

.classic .skill {
    background-image: url("/Assets/Art/Classic/UI/SpellButton.png");
}

.classic .minimap {
    background-image: url("/Assets/Art/Classic/UI/Minimap/MapBackground.png");
}

/* Hovers and presses only change colors, and the original's buttons didn't grow */
.classic .slanted-button:active:enabled,
.classic .hud-action.pulse {
    scale: 1 1;
}

.classic .hud-action.pulse {
    color: var(--color-text);
}

/* What the original didn't show */
.classic .low-health,
.classic .banner,
.classic .boss-bar,
.classic .damage-preview,
.classic .queued-cast,
.classic .skill__key,
.classic .skill__queued,
.classic .entity-info__armor,
.classic .entity-info__effects {
    display: none;
}

/* The original's damage numbers: white, one size, no shadow ramp */
.classic .popup {
    -unity-font-definition: var(--font-display);
    font-size: 40px;
    color: #FFFFFF;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* The damage numbers fade in place, without rising */
.classic .popup--fading,
.classic .popup--score.popup--fading {
    translate: -50% -50%;
}

/* ---- Buttons: the original's color tints ---- */

/* Text buttons: hovered lilac, pressed light grey (white in the pause, as the original's) */
.classic .menu-button:hover,
.classic .menu-button:focus,
.classic .menu-button.options-tab:hover,
.classic .menu-button.options-tab:focus {
    color: var(--classic-hover);
}

.classic .menu-button:active {
    color: var(--classic-pressed);
}

.classic .pause__list > .menu-button:active {
    color: var(--color-text);
}

.classic .slanted-button:hover:enabled,
.classic .outline-button:focus,
.classic .outline-button.reset-button:focus {
    color: var(--classic-hover);
    --line-color: var(--classic-hover);
}

.classic .slanted-button:active:enabled {
    color: var(--classic-pressed);
}

/* Sprite buttons: the tint goes on the sprite, the text stays white, no line or fill drawn */
.classic .hud-action:hover:enabled,
.classic .hud-action:active:enabled,
.classic .hud-bag:hover:enabled,
.classic .hud-bag:active:enabled,
.classic .results__buttons > .outline-button:hover:enabled,
.classic .results__buttons > .outline-button:active:enabled,
.classic .results__buttons > .outline-button:focus,
.classic .options__footer > .outline-button:hover:enabled,
.classic .options__footer > .outline-button:active:enabled,
.classic .options__footer > .outline-button:focus {
    color: var(--color-text);
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
}

.classic .hud-action:hover:enabled {
    -unity-background-image-tint-color: #999999;
}

.classic .hud-bag:hover:enabled {
    -unity-background-image-tint-color: #F5F5F5;
}

.classic .hud-action:active:enabled,
.classic .hud-bag:active:enabled {
    -unity-background-image-tint-color: var(--classic-pressed-hud);
}

.classic .results__buttons > .outline-button:hover:enabled,
.classic .results__buttons > .outline-button:focus,
.classic .options__footer > .outline-button:hover:enabled,
.classic .options__footer > .outline-button:focus {
    -unity-background-image-tint-color: var(--classic-hover);
}

.classic .results__buttons > .outline-button:active:enabled,
.classic .options__footer > .outline-button:active:enabled {
    -unity-background-image-tint-color: var(--classic-pressed);
}

/* ---- HUD: the original's sprites ---- */

/* The status and timeline tabs */
.classic .hud-status,
.classic .hud-timeline {
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    --cut-size: 0;
    --backdrop-blur: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.classic .hud-status {
    background-image: url("/Assets/Art/Classic/UI/Stats Tab.png");
}

.classic .hud-timeline {
    background-image: url("/Assets/Art/Classic/UI/Timeline Tab.png");
}

/* The health and armor bars: the original's filled images, the whole sprite at the bar's full width (558 points), cropped
   on the right by the health rather than squeezed */
.classic .health-bar__fill,
.classic .health-bar__shield {
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    --shadow-color: rgba(0, 0, 0, 0);
    --shadow-offset: 0;
    --cut-size: 0;
    top: 0;
    bottom: 0;
    background-size: 558px 100%;
    background-repeat: no-repeat no-repeat;
    background-position-x: left 0;
    background-position-y: center;
}

.classic .health-bar__fill,
.classic .health-bar--hit > .health-bar__fill {
    --fill-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Art/Classic/UI/Health Bar.png");
}

.classic .health-bar__shield {
    background-image: url("/Assets/Art/Classic/UI/Shield Bar.png");
}

.classic .health-bar__preview {
    --cut-size: 0;
    top: 0;
    bottom: 0;
}

/* The bars jump to their width */
.classic .health-bar__fill,
.classic .health-bar__trail,
.classic .health-bar__preview,
.classic .health-bar__shield {
    transition-duration: 0s;
}

/* The energy cells: the full, previewed and empty sprites, no pop */
.classic .energy-cell {
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    --shadow-offset: 0;
    --cut-size: 0;
    background-image: url("/Assets/Art/Classic/UI/Energy.png");
    -unity-background-scale-mode: stretch-to-fill;
    scale: 1 1;
    opacity: 1;
    transition-duration: 0s;
    /* 45 by 20 in cells 59.7 points apart (UIEnergy's 0.107 of the 558 point row) */
    width: 45.4px;
    height: 20px;
    margin: 0 7.15px;
}

.classic .energy-cell--previewed {
    --fill-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Art/Classic/UI/EnergyPreview.png");
    opacity: 1;
}

.classic .energy-cell--empty,
.classic .energy--refused > .energy-cell--empty {
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Art/Classic/UI/EnergyEmpty.png");
    scale: 1 1;
    opacity: 1;
}

/* The energy costs of the skills and of the pressed artifact */
.classic .cost-tag {
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    --shadow-offset: 0;
    --cut-size: 0;
    background-image: url("/Assets/Art/Classic/UI/SpellEnergy.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* The minimap's rooms, the current one outlined in green, the ones only seen greyed (MinimapElement); the grid jumps to
   the new room. The original's rooms were 30 points every 30, touching: ours touch at the code's 26 point spacing */
.classic .minimap-room,
.classic .minimap-room.visited {
    width: 26px;
    height: 26px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    background-image: url("/Assets/Art/Classic/UI/Minimap/Room.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #808080;
}

.classic .minimap-room.visited {
    -unity-background-image-tint-color: #FFFFFF;
}

.classic .minimap-room.current {
    border-width: 0;
    background-image: url("/Assets/Art/Classic/UI/Minimap/ActiveRoom.png");
    -unity-background-image-tint-color: #FFFFFF;
}

.classic .minimap-room > VisualElement {
    margin: 0;
}

.classic .minimap__rooms {
    transition-duration: 0s;
}

/* ---- HUD: the original's layout (UI.prefab; its canvas is 1920x1080 too, so the points are the same) ---- */

/* Status: Stats Tab, 605 by 90 at 60, 856. The health bar, 558 by 20 (the sprite's aspect in its 558 by 62 slider), 30, 23
   into it, its text in Kallisto 20 bold italic; the energy row 24, 53 into it, 23 high */
.classic .hud-status {
    left: 60px;
    bottom: 134px;
    width: 605px;
    height: 90px;
    padding: 0;
}

.classic .hud-status > .health-bar {
    position: absolute;
    left: 30px;
    top: 23px;
    width: 558px;
    height: 20px;
}

.classic .health-bar__text {
    font-size: 20px;
    -unity-font-style: bold-and-italic;
}

.classic .hud-status > .energy {
    position: absolute;
    left: 24px;
    top: 53px;
    height: 23px;
    margin: 0;
    align-items: center;
}

/* End turn: 425 by 88 centered at the bottom, 134 up, its text 30 bold italic */
.classic .hud-action {
    bottom: 134px;
    width: 425px;
    height: 88px;
    font-size: 30px;
    -unity-font-style: bold-and-italic;
}

/* Timeline: Timeline Tab, 605 by 90 at 60 from the right; its 70 point icons every 95.9 points (TimelineManager's 0.17 of
   the 564 point row) from 41 points in, 2.5 below the tab's middle */
.classic .hud-timeline {
    right: 60px;
    bottom: 134px;
    width: 605px;
    height: 90px;
    padding: 5px 0 0 41px;
}

.classic .timeline-item {
    width: 70px;
    height: 70px;
    margin: 0 12.95px;
}

/* Skills: 100 point squares, their row's middle 67 points up (UISkillsBar). The original spread them over a width
   growing with their count (a slot of 131 to 135 points from 4 to 6 skills, more below): here a 133 point pitch */
.classic .skills {
    bottom: 17px;
    height: 100px;
}

.classic .skill {
    width: 100px;
    height: 100px;
    margin: 0 16.5px;
}

.classic .skill__cooldown {
    font-size: 36px;
    -unity-font-style: bold-and-italic;
}

/* The cost: SpellEnergy, 62 by 31, 42.5 left of the skill's middle and 2.7 above it (SkillCost at 0.73), its figure in
   23 bold italic, a little low */
.classic .skill__cost {
    left: -23.7px;
    top: -2.7px;
    width: 62.4px;
    height: 30.6px;
}

.classic .skill__cost > .cost-tag__value {
    font-size: 23px;
    -unity-font-style: bold-and-italic;
    translate: 0 2.4px;
}

/* The skill's tooltip: Hover Artefact Info, 426 by 80 centered 235 above the bottom, Bicyclette 18 inside 40 by 10 */
.classic #Tooltip {
    bottom: 235px;
    width: 426px;
    max-width: 426px;
    min-height: 80px;
    padding: 10px 40px;
    font-size: 18px;
}

/* The timeline's tooltip: InfoboxTimeline, 250 by 150 above the icon, Kallisto 20 centered */
.classic .tooltip--anchored {
    width: 250px;
    max-width: 250px;
    min-height: 150px;
    padding: 11px 0;
    font-size: 20px;
    -unity-font-definition: var(--font-display);
    -unity-text-align: middle-center;
    background-image: url("/Assets/Art/Classic/UI/Timeline/InfoboxTimeline.png");
}

/* The buffs: the attack icon 90 points at 70, 969, the defense one 69 points at 190, 980, their turns in Kallisto 22 bold
   italic centered at 151 and 251, 1041. The row becomes a point at the top left so that its icons take canvas positions */
.classic .status-effects {
    left: 0;
    top: 0;
    bottom: auto;
    width: 0;
    height: 0;
}

.classic .status-effect {
    position: absolute;
    margin: 0;
}

.classic .status-effect--attack {
    left: 69.7px;
    top: 968.8px;
    width: 90px;
    height: 90px;
}

.classic .status-effect--defense {
    left: 190.4px;
    top: 979.5px;
    width: 68.6px;
    height: 68.6px;
}

.classic .status-effect > .unity-label {
    right: auto;
    bottom: auto;
    width: 27.4px;
    height: 17.5px;
    margin: 0;
    padding: 0;
    font-size: 22px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
}

.classic .status-effect--attack > .unity-label {
    left: 67.6px;
    top: 63.4px;
}

.classic .status-effect--defense > .unity-label {
    left: 46.9px;
    top: 52.7px;
}

/* Bag: 66 points, 60 from the right, 32.5 from the bottom, BAG in 20 bold italic */
.classic .hud-bag {
    right: 60px;
    bottom: 32.5px;
    width: 66px;
    height: 66px;
    font-size: 20px;
    -unity-font-style: bold-and-italic;
}

/* Minimap: MapBackground at 0.8, 280 points at 30 from the top right, the rooms in its middle 240 */
.classic .minimap {
    top: 30px;
    right: 30px;
    width: 280px;
    height: 280px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.8);
}

.classic .minimap__view {
    left: 20px;
    top: 20px;
    right: 20px;
    bottom: 20px;
}

/* The hovered enemy: Hover_Entity, 332 by 132, its name in 20 bold italic 21 points above the middle, its health in the
   original's pink and its movement in green in 22 bold italic 20 below, no line between. EntityInfoPanel still places it */
.classic .entity-info {
    width: 332px;
    height: 132px;
    min-height: 0;
    padding: 0;
}

.classic .entity-info .separator {
    display: none;
}

.classic .entity-info .entity-info__name {
    font-size: 20px;
    -unity-font-style: bold-and-italic;
    margin-bottom: 16px;
}

.classic .entity-info__stats > .unity-label {
    font-size: 22px;
    -unity-font-style: bold-and-italic;
}

.classic .entity-info .entity-info__health {
    color: #E82A65;
}

.classic .entity-info .entity-info__movement {
    color: #20D15F;
}

/* ---- HUD: no animation the original didn't have ---- */

/* The skills are all there at once and neither lift nor press in; an unusable one has its icon greyed, as the original's */
.classic .skill,
.classic .skill--shown:hover,
.classic .skill--shown:active {
    scale: 1 1;
    translate: 0 0;
    opacity: 1;
    transition-duration: 0s;
}

.classic .skill--shown.unusable {
    opacity: 1;
}

.classic .skill.unusable > .skill__icon {
    -unity-background-image-tint-color: #808080;
}

/* The selected skill: its frame tinted purple, as the original's */
.classic .skill.selected {
    -unity-background-image-tint-color: rgb(116, 89, 216);
}

/* The timeline neither dims nor grows, no marker */
.classic .timeline-item {
    transition-duration: 0s;
}

.classic .in-combat > .timeline-item {
    opacity: 1;
}

.classic .in-combat > .timeline-item.current {
    scale: 1 1;
}

.classic .timeline-item__marker {
    display: none;
}

/* The tooltips and the enemy info show and hide at once, in place */
.classic .fade-in {
    transition-duration: 0s;
}

.classic .tooltip,
.classic .tooltip.shown {
    translate: -50% 0;
}

.classic .tooltip--status,
.classic .tooltip--status.shown,
.classic .tooltip--anchored,
.classic .tooltip--anchored.shown {
    translate: 0 0;
}

.classic .entity-info {
    scale: 1 1;
}

/* The status icons appear at once, without the punch */
.classic .status-effect,
.classic .status-effect.status-effect--pop {
    scale: 1 1;
    transition-duration: 0s;
}

/* ---- Menus ---- */

/* The buttons of the menu lists are in place at once; no accent bar under the hovered one (the selected tab keeps its bar) */
.classic .menu-list > .menu-button {
    translate: 0 0;
    opacity: 1;
}

.classic .menu-button__bar {
    transition-duration: 0s;
}

.classic .menu-button:hover > .menu-button__bar,
.classic .menu-button:focus > .menu-button__bar {
    width: 0;
}

.classic .menu-button.options-tab--selected > .menu-button__bar {
    width: 100%;
}

/* The sliders: the original's white track and fill (SliderOptions), a handle that doesn't grow */
.classic .setting-slider #unity-tracker,
.classic .setting-slider #unity-fill {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Art/Classic/UI/Settings/SliderOptions.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.classic .setting-slider #unity-dragger {
    transition-duration: 0s;
}

.classic .setting-slider:hover #unity-dragger,
.classic .setting-slider:focus #unity-dragger {
    scale: 1 1;
    -unity-background-image-tint-color: #F5F5F5;
}

/* The options' footer buttons: the original's return and default settings sprites */
.classic .options__footer > .outline-button {
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    --cut-size: 0;
    --backdrop-blur: 0;
    background-image: url("/Assets/Art/Classic/UI/Settings/ReturnButton.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.classic .options__footer > .outline-button.reset-button {
    color: var(--color-text);
    background-image: url("/Assets/Art/Classic/UI/Settings/DefaultParametersButton.png");
}

/* The options keep our layout: the original's were sections (video, audio) with their own reset buttons, not tabs */

/* Main menu (1-Menu, Canvas | MainMenu): the logo 1077 by 414 at 422, 147; Play (64), Options, Credits (38, bold italic)
   and Quit (38 italic) centered on 957 at 661, 780, 882 and 986; 55 point white lines between them, drawn by the list's
   separators (at 722, 828 and 933: the original's second one was at 832) */
.classic .main-menu__logo {
    position: absolute;
    left: 421.7px;
    top: 147.3px;
    width: 1076.6px;
    height: 413.5px;
    margin: 0;
}

.classic .main-menu__buttons {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding-top: 722.5px;
}

.classic .main-menu .separator {
    width: 55px;
    height: 0;
    margin: 0 0 104.5px 0;
    border-top-width: 1px;
    border-color: #FFFFFF;
}

.classic .main-menu__buttons > .menu-button {
    position: absolute;
    left: 806.4px;
    width: 301.7px;
    height: 76.9px;
    font-size: 38px;
    -unity-font-style: bold-and-italic;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.classic .main-menu__buttons > #Play {
    top: 622.7px;
    font-size: 64px;
}

.classic .main-menu__buttons > #OpenOptions {
    top: 741.5px;
}

.classic .main-menu__buttons > #OpenCredits {
    top: 843.4px;
}

.classic .main-menu__buttons > #Quit {
    left: 858.2px;
    top: 959.6px;
    width: 203.6px;
    height: 53.1px;
    -unity-font-style: italic;
}

/* Credits (Canvas | Credits): no panel over the scene, the texts centered, the titles in Kallisto 46 bold, the names in
   Bicyclette 38; Return, the original's sprite, 219 by 55 at 44, 40 */
.classic #Credits > .backdrop {
    background-color: rgba(0, 0, 0, 0);
}

.classic #Credits > .side-panel {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: auto;
    padding: 0;
    align-items: center;
    justify-content: flex-start;
    translate: 0 0;
    transition-duration: 0s;
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
}

.classic #Credits .title {
    margin-top: 67px;
    height: 50px;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.classic #Credits .separator {
    display: none;
}

.classic .credits__content {
    align-items: center;
}

.classic .credits__role {
    margin-top: 70px;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.classic .credits__names {
    font-size: 38px;
    color: var(--color-text);
    -unity-text-align: upper-center;
}

.classic #CloseCredits {
    position: absolute;
    left: 44.2px;
    top: 40.3px;
    width: 219.2px;
    min-width: 0;
    height: 54.5px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    -unity-font-style: bold-and-italic;
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Art/Classic/UI/Settings/ReturnButton.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.classic #CloseCredits:hover:enabled,
.classic #CloseCredits:active:enabled,
.classic #CloseCredits:focus {
    color: var(--color-text);
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
}

.classic #CloseCredits:hover:enabled,
.classic #CloseCredits:focus {
    -unity-background-image-tint-color: var(--classic-hover);
}

.classic #CloseCredits:active:enabled {
    -unity-background-image-tint-color: var(--classic-pressed);
}

/* The disclaimer, as the original's pre-menu page: on black, no card, the title in Kallisto 70 bold blue, the text in
   Bicyclette 36, the button a 276 by 58 blue block with its text in 30 (hovered and pressed darker) */
.classic #Disclaimer > .backdrop {
    background-color: #000000;
}

.classic .dialog__card {
    width: 1288px;
    padding: 0;
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    --backdrop-blur: 0;
    --cut-size: 0;
}

.classic .dialog__title {
    font-size: 70px;
    -unity-font-style: bold;
    color: #5252EF;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.classic .dialog__text {
    font-size: 36px;
}

.classic #CloseDisclaimer {
    min-width: 0;
    width: 275.7px;
    height: 58.4px;
    padding: 0;
    font-size: 30px;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    --cut-size: 0;
    --backdrop-blur: 0;
    --line-color: rgba(0, 0, 0, 0);
    --fill-color: #5252EF;
}

.classic #CloseDisclaimer:hover:enabled,
.classic #CloseDisclaimer:focus {
    color: var(--color-text);
    --line-color: rgba(0, 0, 0, 0);
    --fill-color: #34349F;
}

.classic #CloseDisclaimer:active:enabled {
    color: var(--color-text);
    --fill-color: #232371;
}

/* Pause (the classic class is on #Pause): the original's panel sprite at 0.8 alpha sliding in over 0.167 s linearly,
   on black at 0.8, the title in place */
#Pause.classic {
    transition-duration: 0.167s;
    transition-timing-function: linear;
}

#Pause.classic > .backdrop {
    background-color: rgba(0, 0, 0, 0.8);
}

#Pause.classic .side-panel {
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    --cut-size: 0;
    --backdrop-blur: 0;
    background-image: url("/Assets/Art/Classic/UI/Pause.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.8);
    transition-duration: 0.167s;
    transition-timing-function: linear;
}

.classic .pause__title {
    translate: 0 0;
    opacity: 1;
    transition-duration: 0s;
}

/* The original's layout (Canvas _ Pause, its panel at rest after PauseMenuAnimation): the panel 688 points wide from the
   right edge, over the whole height (it widens for our options, which the original fitted in the same panel); no title;
   Options, Resume, Main menu and Quit in Kallisto 38 bold italic, Options centered at 1766, 386, the others right-aligned
   on 1861 at 505, 624 and 736, a 235 point white line above each of these three */
#Pause.classic .side-panel {
    width: 688px;
}

#Pause.classic .side-panel.side-panel--wide {
    width: 58%;
}

#Pause.classic .pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

#Pause.classic .pause__title,
#Pause.classic .pause > .accent-line,
#Pause.classic .pause__list > .separator {
    display: none;
}

#Pause.classic .pause__list {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
}

#Pause.classic .pause__list > .menu-button {
    position: absolute;
    height: 48px;
    margin: 0;
    font-size: 38.4px;
    -unity-font-style: bold-and-italic;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    -unity-text-align: middle-right;
}

#Pause.classic #OpenOptions {
    left: 402px;
    top: 366.2px;
    width: 255.8px;
    align-items: center;
    -unity-text-align: middle-center;
}

#Pause.classic #Resume {
    left: 154.4px;
    top: 485.5px;
    width: 470.5px;
}

#Pause.classic #MainMenu {
    left: 132.9px;
    top: 604.2px;
    width: 493.5px;
}

#Pause.classic #Quit {
    left: 146.4px;
    top: 716.3px;
    width: 478.7px;
}

/* The lines, drawn by the buttons' bars as borders (a 1 point tall element can vanish under 1080p) */
#Pause.classic #Resume > .menu-button__bar,
#Pause.classic #MainMenu > .menu-button__bar,
#Pause.classic #Quit > .menu-button__bar {
    right: auto;
    bottom: auto;
    width: 234.8px;
    height: 0;
    border-top-width: 1.4px;
    border-color: #FFFFFF;
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0s;
}

#Pause.classic #Resume > .menu-button__bar {
    left: 234px;
    top: -39.1px;
}

#Pause.classic #MainMenu > .menu-button__bar {
    left: 255.5px;
    top: -38.6px;
}

#Pause.classic #Quit > .menu-button__bar {
    left: 242px;
    top: -34.3px;
}

/* The dialog appears at its size */
.classic .dialog__card {
    scale: 1 1;
    transition-duration: 0s;
}

/* Results (the classic class is on #Results): the original's death screen, black at 0.9, the texts in place, a 36 px
   message in its pink or green, a 25 px score, 250 by 70 DeathScreenButton buttons with 20 px texts */
.classic.results > .backdrop {
    background-color: rgba(0, 0, 0, 0.9);
}

.classic.results > .unity-label,
.classic.results > .results__buttons {
    translate: 0 0;
    opacity: 1;
    transition-duration: 0s;
}

/* The original's layout (Canvas _ Death): the message centered on 465, the buttons 250 by 70 at 665 and 1005, 505, the
   score under them, centered on 620 */
.classic .results__message {
    position: absolute;
    left: 570px;
    top: 450px;
    width: 780px;
    height: 30.7px;
    margin: 0;
    font-size: 36px;
    -unity-font-style: bold-and-italic;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.classic .results__buttons {
    position: absolute;
    left: 665px;
    top: 505px;
    width: 590px;
    height: 70px;
    justify-content: space-between;
}

.classic .results__score {
    position: absolute;
    left: 784.8px;
    top: 609.1px;
    width: 350.4px;
    height: 21.9px;
    margin: 0;
}

.classic .results__message.defeat {
    color: rgb(232, 42, 104);
}

.classic .results__message.victory {
    color: rgb(25, 207, 21);
}

.classic .results__score {
    font-size: 25px;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.classic .results__buttons > .outline-button {
    min-width: 0;
    width: 250px;
    height: 70px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    --cut-size: 0;
    --backdrop-blur: 0;
    background-image: url("/Assets/Art/Classic/UI/DeathScreenButton.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ---- Inventory (the classic class is on #Inventory) ---- */

/* The inventory shows at once and its panels scale from 0 to 1 over 0.125 s linearly, as the original's */
.classic.inventory {
    transition-duration: 0s;
}

.classic .inventory-panel {
    scale: 0 0;
    transition-duration: 0.125s;
    transition-timing-function: linear;
}

.classic.open .inventory-panel {
    scale: 1 1;
}

/* The original's panels (UI.prefab, InventoryMenu): the character sheet (Character Tab) 607 by 701 at 57, 75, or the
   chest (Inventory Tab) at 58, 74; the artifact's details (Artefact Info Tab) 604 by 694 at 638, 80; the inventory
   (Inventory Tab) 607 by 701 at 1257, 74. Their children are placed from the panels' top left corners */
.classic .inventory-panel {
    padding: 0;
    align-items: flex-start;
    translate: 0 0;
    --fill-color: rgba(0, 0, 0, 0);
    --line-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.classic #PlayerInfo {
    left: 57px;
    top: 75px;
    width: 607px;
    height: 701px;
    background-image: url("/Assets/Art/Classic/UI/Character Tab.png");
}

.classic #Chest {
    left: 58px;
    top: 74px;
    width: 607px;
    height: 701px;
    background-image: url("/Assets/Art/Classic/UI/Inventory Tab.png");
}

.classic #Description {
    left: 638px;
    top: 80px;
    width: 604px;
    height: 694px;
    background-image: url("/Assets/Art/Classic/UI/Artefact Info Tab.png");
}

.classic #PlayerInventory {
    left: 1257px;
    right: auto;
    top: 74px;
    width: 607px;
    height: 701px;
    background-image: url("/Assets/Art/Classic/UI/Inventory Tab.png");
}

/* The titles in Kallisto 30 bold italic, the subtitles in white Bicyclette 20, centered on the heights of the original's */
.classic .inventory-panel > .inventory-panel__title {
    position: absolute;
    left: 0;
    right: 0;
    height: 40px;
    font-size: 30px;
    -unity-font-style: bold-and-italic;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.classic .inventory-panel > .inventory-panel__subtitle {
    position: absolute;
    left: 0;
    right: 0;
    height: 30px;
    margin: 0;
    font-size: 20px;
    color: var(--color-text);
}

.classic #PlayerInventory > .inventory-panel__title,
.classic #Chest > .inventory-panel__title {
    top: 36.7px;
}

.classic #PlayerInventory > .inventory-panel__subtitle,
.classic #Chest > .inventory-panel__subtitle {
    top: 75.5px;
}

/* 23.6 right of the middle */
.classic #Description > .inventory-panel__title {
    left: 47.2px;
    top: 30px;
}

.classic #Description > .inventory-panel__subtitle {
    left: 47.2px;
    top: 69.7px;
}

/* The explorer's name in 27.4, the subtitle in 16 */
.classic #PlayerInfo > .inventory-panel__title {
    top: 48px;
    font-size: 27.4px;
}

.classic #PlayerInfo > .inventory-panel__subtitle {
    top: 85px;
    font-size: 16px;
}

/* The grids: the original's cells were 90 points, ours stay 80 (a scaled grid would shift the drag and drop): the grid is
   centered in the original's 450 point area, 79, 143 into the panel */
.classic .inventory-panel > .inventory-grid {
    position: absolute;
    left: 104.2px;
    top: 167.7px;
    margin: 0;
}

/* The character sheet: the portrait 311 by 408 at -2, 105; the stats and feats from 306, their headers in 17.5 bold italic
   and their lines in light grey 15 italic every 23.6 points; the zone's title (18 bold italic) and text (Bicyclette 15)
   at 76, 513 and 75, 546; the score in 18 bold italic at 393, 660 */
.classic .player-info {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    height: auto;
}

.classic .player-info__portrait {
    position: absolute;
    left: -2px;
    top: 105px;
    width: 311px;
    height: 408px;
    background-image: url("/Assets/Art/Classic/UI/Character.png");
}

.classic .player-info__stats {
    position: absolute;
    left: 306px;
    top: 125.5px;
    width: 287px;
    margin: 0;
}

.classic .player-info__header {
    height: 30px;
    margin: 32.5px 0 12px 0;
    padding: 0;
    border-bottom-width: 0;
    font-size: 17.5px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.classic .unity-label.player-info__line {
    height: 23.6px;
    margin: 0;
    font-size: 15px;
    -unity-font-style: italic;
    -unity-text-align: middle-left;
    color: #CCCCCC;
}

.classic .player-info__zone-title {
    position: absolute;
    left: 76px;
    top: 513px;
    width: 341px;
    height: 28px;
    margin: 0;
    font-size: 18px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.classic .player-info__zone-text {
    position: absolute;
    left: 75px;
    top: 546px;
    width: 470px;
    height: 83px;
    margin: 0;
    font-size: 15px;
    color: var(--color-text);
    -unity-text-align: upper-left;
}

.classic .player-info__score {
    left: 393px;
    top: 660px;
    right: auto;
    bottom: auto;
    width: 200px;
    height: 24px;
    font-size: 18px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

/* The pressed artifact: its icon 180 points at 232, 106, no frame; under it the original's cooldown and energy sprite,
   190 by 45 (Artefact CD Energy), the cooldown in black and the cost in white, 20 bold italic, on its ring and its tag;
   the hints in Bicyclette 16 on either side */
.classic .artifact-info__icon {
    position: absolute;
    left: 232px;
    top: 106px;
    width: 180px;
    height: 180px;
    margin: 0;
    border-width: 0;
}

.classic .artifact-info__cooldown {
    left: -2px;
    top: 137px;
    bottom: auto;
    width: 190px;
    height: 45px;
    translate: 0 0;
    justify-content: flex-start;
    align-items: flex-start;
}

.classic .artifact-info__cooldown-disc {
    display: none;
}

.classic .artifact-info__cooldown-ring {
    background-image: url("/Assets/Art/Classic/UI/Artefact CD Energy.png");
    background-size: 100% 100%;
    background-position-x: left 0;
}

.classic .artifact-info__cooldown-value {
    position: absolute;
    left: 0;
    top: 3px;
    width: 39px;
    height: 41px;
    margin: 0;
    font-size: 20px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
}

.classic .artifact-info__cost {
    left: 119px;
    top: 149px;
    right: auto;
    bottom: auto;
    width: 68px;
    height: 23px;
    translate: 0 0;
    background-image: none;
}

.classic .artifact-info__cost > .cost-tag__value {
    font-size: 20px;
    -unity-font-style: bold-and-italic;
}

.classic .artifact-info__hint {
    width: 98px;
    height: 19px;
    font-size: 16px;
}

.classic .artifact-info__cooldown > .artifact-info__hint {
    top: 14px;
}

.classic .artifact-info__cost > .artifact-info__hint {
    top: 2px;
}

/* The name and effects: 338 point wide boxes at 154, 324 and 154, 489 without frames, their titles in 20 bold italic
   and their texts in Bicyclette 18, left-aligned */
.classic #Description {
    padding-top: 324px;
}

.classic .artifact-info__box {
    align-self: flex-start;
    width: 338px;
    height: 103px;
    min-height: 0;
    margin: 0 0 62px 154px;
    padding: 2px 4px 0 4px;
    border-width: 0;
}

.classic .artifact-info__box-title {
    height: 26px;
    margin-bottom: 6px;
    font-size: 20px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
}

.classic .artifact-info__box-text {
    font-size: 18px;
    -unity-text-align: upper-left;
}

/* The pieces are neither pressed in the hand nor bounce when put down */
.classic .artifact-piece__body,
.classic .artifact-piece--held > .artifact-piece__body,
.classic .artifact-piece--landing > .artifact-piece__body {
    scale: 1 1;
    transition-duration: 0s;
}

.classic .artifact-piece__icon {
    transition-duration: 0s;
}
