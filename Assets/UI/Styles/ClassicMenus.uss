/*
 * The Classic edition's look of the menus (docs/features/editions.md), after Classic.uss: main menu, options, credits, disclaimer, pause and results.
 */

/* ---- Menus ---- */

/* The buttons of the menu lists are in place at once; no accent bar under the hovered one (the selected tab keeps its bar) */
.classic .menu-list > .menu-button {
    translate: 0 0;
    opacity: 1;
}

.classic .menu-button__bar {
    transition-duration: 0s;
}

.classic .menu-button:hover > .menu-button__bar,
.classic .menu-button:focus > .menu-button__bar {
    width: 0;
}

.classic .menu-button.options-tab--selected > .menu-button__bar {
    width: 100%;
}

/* The original's menu texts had no shadow (none of its TMP materials had an underlay) */
.classic .menu-button,
/* The original changed its language without a fade */
.classic .options--relocalizing {
    opacity: 1;
}

.classic .menu-button.options-tab,
.classic .title,
.classic .section-title,
.classic .outline-button {
    text-shadow: 0 0 0 var(--color-clear);
}

/* The original's color tints faded in 0.1 s (m_FadeDuration of its buttons): the text buttons' color, the sprite buttons'
   tint */
.classic .menu-button {
    transition-duration: 0s, 0s, 0.1s;
}

.classic .slanted-button {
    transition-property: color, -unity-background-image-tint-color;
    transition-duration: 0.1s, 0.1s;
}

/* A selected button was tinted #F5F5F5, near white (a clicked one stayed selected): the focus is not the hover's lilac.
   The hover and the press come after it, so that they win */
.classic .menu-button:focus,
.classic .menu-button.options-tab:focus {
    color: var(--classic-focus);
}

.classic .menu-button:hover,
.classic .menu-button.options-tab:hover {
    color: var(--classic-hover);
}

.classic .menu-button:active,
.classic .menu-button.options-tab:active {
    color: var(--classic-pressed);
}

.classic .results__buttons > .outline-button:focus,
.classic .options__footer > .outline-button:focus {
    -unity-background-image-tint-color: var(--classic-focus);
}

/* ---- Options ---- */

/* The sliders (the original's Slider prefab): 230 by 20, the white track and fill of SliderOptions (5 tall at a 0.5 scale, so
   2.5 points), the 20 point CursorOptions handle, tinted #F5F5F5 hovered and #C8C8C8 pressed in 0.1 s, not growing */
.classic .setting-slider {
    width: 230px;
    translate: 0 0;
}

.classic .setting-slider #unity-tracker,
.classic .setting-slider #unity-fill {
    height: 2.5px;
    margin-top: -1.25px;
    background-color: var(--color-clear);
    background-image: url("/Assets/Art/Classic/UI/Menus/Options/SliderOptions.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.classic .setting-slider #unity-dragger {
    width: 20px;
    height: 20px;
    margin-top: -9px;
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.1s;
}

.classic .setting-slider:hover #unity-dragger,
.classic .setting-slider:focus #unity-dragger {
    scale: 1 1;
    -unity-background-image-tint-color: var(--classic-focus);
}

.classic .setting-slider:active #unity-dragger,
.classic .setting-slider #unity-dragger:active {
    -unity-background-image-tint-color: var(--classic-pressed);
}

/* A setting, as the original's (the Luminosite and Contraste prefabs): its name above its control, in Bicyclette 28 white,
   centered, 100 points a setting; the names don't light up when hovered */
.classic .setting {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100px;
    border-bottom-width: 0;
}

.classic .setting > .unity-label {
    flex-grow: 0;
    margin: 0 0 8px 0;
    font-size: 28px;
    color: var(--classic-text);
    -unity-text-align: middle-center;
}

.classic .setting:hover > .unity-label {
    color: var(--classic-text);
}

/* The value (ours only), as the original's grey captions of the sliders (0 and 100, <i><font-weight=700> of Kallisto:
   the real Bold Italic face, #9A9A9A), right of the slider */
.classic .setting > .setting__value,
.classic .setting:hover > .setting__value {
    position: absolute;
    left: 955px;
    bottom: 26px;
    width: 80px;
    margin: 0;
    font-size: 14px;
    color: var(--classic-caption);
    -unity-font-definition: url("/Assets/TextMesh Pro/Resources/Fonts & Materials/Kallisto/Source/Kallisto Bold Italic.otf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

/* The original's options had no notes (the F2 key's): its settings are laid out without room for one */
/* The settings of what the original didn't have */
.classic .setting--anniversary {
    display: none;
}

.classic .setting > .setting__hint {
    display: none;
}

/* The choices (ours only: language, edition, fullscreen, vertical sync) wear the original's sprite buttons: ReturnButton at
   its 4:1 aspect, Kallisto Medium 20 upright, the text grey (#9A9A9A) and white when chosen; the sprite hovered #9D9BBA,
   selected #F5F5F5, pressed #C8C8C8 */
.classic .language-list {
    justify-content: center;
}

.classic .language-list > .outline-button,
.classic .setting > .outline-button {
    min-width: 0;
    width: 180px;
    height: 45px;
    margin: 0 8px;
    padding: 0;
    font-size: 20px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    background-image: url("/Assets/Art/Classic/UI/Menus/Options/ReturnButton.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.classic .language-list > .outline-button,
.classic .language-list > .outline-button:hover:enabled,
.classic .language-list > .outline-button:focus,
.classic .setting > .outline-button,
.classic .setting > .outline-button:hover:enabled,
.classic .setting > .outline-button:focus {
    color: var(--color-muted);
    --fill-color: var(--color-clear);
    --line-color: var(--color-clear);
}

.classic .language-list > .outline-button--selected,
.classic .language-list > .outline-button--selected:hover:enabled,
.classic .language-list > .outline-button--selected:focus,
.classic .setting > .outline-button--selected,
.classic .setting > .outline-button--selected:hover:enabled,
.classic .setting > .outline-button--selected:focus {
    color: var(--color-text);
}

.classic .language-list > .outline-button:focus,
.classic .setting > .outline-button:focus {
    -unity-background-image-tint-color: var(--classic-focus);
}

.classic .language-list > .outline-button:hover:enabled,
.classic .setting > .outline-button:hover:enabled {
    -unity-background-image-tint-color: var(--classic-hover);
}

.classic .language-list > .outline-button:active:enabled,
.classic .setting > .outline-button:active:enabled {
    -unity-background-image-tint-color: var(--classic-pressed);
}

/* The options' footer buttons: the original's return and default settings sprites at their own size (Return 219 by 55, its
   4:1 aspect; Default settings 306 by 73), Kallisto Medium 20 upright */
.classic .options__footer > .outline-button {
    --fill-color: var(--color-clear);
    --line-color: var(--color-clear);
    --cut-size: 0;
    --backdrop-blur: 0;
    min-width: 0;
    padding: 0;
    font-size: 20px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    background-image: url("/Assets/Art/Classic/UI/Menus/Options/ReturnButton.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.classic .options__footer > #Back {
    width: 219.2px;
    height: 54.5px;
}

.classic .options__footer > .outline-button.reset-button {
    width: 306.25px;
    height: 72.9px;
    color: var(--color-text);
    background-image: url("/Assets/Art/Classic/UI/Menus/Options/DefaultParametersButton.png");
}

/* The main menu's options (1-Menu, Canvas | Options): no panel, the scene showing through, over the whole screen; the title
   in upright Kallisto Bold 38, centered from 84 to 134; white lines 1660 points wide from 130, 1.5 tall, at 214 above the
   section title and at 850 above Return. Our tabs play the original's section titles (Video, Audio: Kallisto Medium 26
   upright, centered on 251) and show one section at a time, its settings in a centered column from 290 */
.classic #OptionsScreen > .backdrop {
    background-color: var(--color-clear);
}

.classic #OptionsScreen > .side-panel {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: auto;
    padding: 84px 130px 0 130px;
    align-items: center;
    justify-content: flex-start;
    translate: 0 0;
    --fill-color: var(--color-clear);
    --line-color: var(--color-clear);
}

.classic #OptionsScreen .options {
    width: 1660px;
    align-self: center;
}

.classic .options__header {
    align-items: center;
    height: 50px;
    margin-bottom: 80px;
}

.classic .options__header > .title {
    height: 50px;
    margin: 0;
    font-size: 38px;
    -unity-font-definition: var(--classic-font-bold);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.classic .options__header > .accent-line {
    display: none;
}

.classic .options__tabs {
    justify-content: center;
    border-bottom-width: 0;
    border-top-width: 1.5px;
    border-color: var(--classic-line);
    padding-top: 20px;
    margin-bottom: 20px;
}

.classic .menu-button.options-tab {
    height: 35px;
    margin: 0 24px;
    font-size: 26px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.classic .options-tab > .menu-button__bar {
    background-color: var(--classic-line);
}

/* The original's section titles had no keys turning them, its luminosity no calibration */
.classic .options__page-key,
.classic .calibration {
    display: none;
}

/* The page ends on the original's last line, at 850 */
.classic .options__page {
    height: 561px;
    border-bottom-width: 1.5px;
    border-color: var(--classic-line);
}

/* Return centered at the bottom (850, 930); Default settings on the right of the section (1373, 434), out of the flow */
.classic #OptionsScreen .options__footer {
    position: absolute;
    left: 0;
    top: 845.8px;
    right: 0;
    height: 54.5px;
    margin: 0;
    justify-content: center;
}

.classic #OptionsScreen .options__footer > .outline-button.reset-button {
    position: absolute;
    left: 1243px;
    top: -495.8px;
}

/* ---- Main menu ---- */

/* Main menu (1-Menu, Canvas | MainMenu): the logo 1077 by 414 at 422, 147; Play (64), Options, Credits and Quit (38) in
   upright Kallisto Bold, centered on 957 at 661, 780, 882 and 986; 55 point white lines between them, drawn by the list's
   separators (at 722, 828 and 933: the original's second one was at 832) */
.classic .main-menu__logo {
    position: absolute;
    left: 421.7px;
    top: 147.3px;
    width: 1076.6px;
    height: 413.5px;
    margin: 0;
}

/* The badge in the original's fonts */
.classic .main-menu__best {
    -unity-font-definition: var(--classic-font-bold);
    -unity-font-style: normal;
    color: var(--classic-text);
}

.classic .edition-badge {
    -unity-font-definition: var(--classic-font-bold);
    -unity-font-style: normal;
}

/* The original named no edition */
.classic .main-menu__edition {
    display: none;
}

.classic .main-menu__buttons {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding-top: 722.5px;
}

.classic .main-menu .separator {
    align-self: center;
    width: 55px;
    height: 0;
    margin: 0 0 104.5px 0;
    border-top-width: 1px;
    border-color: var(--classic-line);
}

.classic .main-menu__buttons > .menu-button {
    position: absolute;
    left: 806.4px;
    width: 301.7px;
    height: 76.9px;
    font-size: 38px;
    -unity-font-definition: var(--classic-font-bold);
    -unity-font-style: normal;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.classic .main-menu__buttons > #Play {
    top: 622.7px;
    font-size: 64px;
}

.classic .main-menu__buttons > #OpenOptions {
    top: 741.5px;
}

.classic .main-menu__buttons > #OpenCredits {
    top: 843.4px;
}

.classic .main-menu__buttons > #Quit {
    left: 858.2px;
    top: 959.6px;
    width: 203.6px;
    height: 53.1px;
}

/* ---- Credits ---- */

/* Credits (Canvas | Credits, texts without a localizer: their tags showed): no panel over the scene, the texts centered, the
   title and the roles in 46 <font-weight=700> of Kallisto (the real Bold face) in 50 point boxes, the names in Bicyclette 38
   31 points under their role's box; Return, the original's sprite, 219 by 55 at 44, 40, Kallisto Medium 20 upright */
.classic #Credits > .backdrop {
    background-color: var(--color-clear);
}

.classic #Credits > .side-panel {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: auto;
    padding: 0;
    align-items: center;
    justify-content: flex-start;
    translate: 0 0;
    transition-duration: 0s;
    --fill-color: var(--color-clear);
    --line-color: var(--color-clear);
}

.classic #Credits .title {
    margin-top: 67px;
    height: 50px;
    font-size: 46px;
    -unity-font-definition: var(--classic-font-bold);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.classic #Credits .separator {
    display: none;
}

.classic .credits__content {
    align-items: center;
}

/* The scroll of the original's Credits.anim (played at 0.02): the title and the texts together, 3292 points up in 35 s,
   easing in and out (its flat tangents), lengthened at the same speed by the Anniversary's three sections (1086 points). The texts start under the title, unclipped and never shrunk; closing snaps them
   back (no transition out of open) and reopening starts again */
.classic #Credits .credits {
    position: absolute;
    left: 0;
    top: 117px;
    right: 0;
    bottom: -3000px;
    overflow: visible;
}

.classic #Credits .credits__content {
    flex-shrink: 0;
}

.classic #Credits.open .title,
.classic #Credits.open .credits__content {
    translate: 0 -4378px;
    transition-property: translate;
    transition-duration: 46.5s;
    transition-timing-function: ease-in-out;
}

.classic .credits__role {
    height: 50px;
    /* The original's blocks sat at fixed heights: about 190 points from a section's last name to the next title */
    margin-top: 137px;
    font-size: 46px;
    -unity-font-definition: var(--classic-font-bold);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.classic .credits__names {
    margin-top: 31px;
    font-size: 38px;
    color: var(--color-text);
    -unity-text-align: upper-center;
    /* Bicyclette SDF with <font-weight="300"> (no LocalizedUITextSetter: the tag showed), line spacing 12: a line every 48 points */
    -unity-font-definition: url("/Assets/TextMesh Pro/Resources/Fonts & Materials/Bicyclette/Source/Bicyclette-Light.ttf");
    -unity-font-style: normal;
    -unity-paragraph-spacing: 7.6px;
}

.classic #CloseCredits {
    position: absolute;
    left: 44.2px;
    top: 40.3px;
    width: 219.2px;
    min-width: 0;
    height: 54.5px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    -unity-font-style: normal;
    --fill-color: var(--color-clear);
    --line-color: var(--color-clear);
    background-image: url("/Assets/Art/Classic/UI/Menus/Options/ReturnButton.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.classic #CloseCredits:hover:enabled,
.classic #CloseCredits:active:enabled,
.classic #CloseCredits:focus {
    color: var(--color-text);
    --fill-color: var(--color-clear);
    --line-color: var(--color-clear);
}

.classic #CloseCredits:focus {
    -unity-background-image-tint-color: var(--classic-focus);
}

.classic #CloseCredits:hover:enabled {
    -unity-background-image-tint-color: var(--classic-hover);
}

.classic #CloseCredits:active:enabled {
    -unity-background-image-tint-color: var(--classic-pressed);
}

/* ---- Disclaimer ---- */

/* The disclaimer, as the original's pre-menu page (0-PreMenu, one text without a localizer): on black, no card, the text
   1288 points wide from 104, top-aligned; the title in 70 <font-weight=700> of Kallisto (the real Bold face), blue, then a
   blank line, the text in Kallisto Medium 36 white (left-aligned: the original's was justified); the button a 276 by 58 blue
   block at 822, 849, its text in Kallisto Medium 30 (hovered and pressed darker) */
.classic #Disclaimer {
    justify-content: flex-start;
}

.classic #Disclaimer > .backdrop {
    background-color: var(--classic-black);
}

.classic .dialog__card {
    width: 1288px;
    padding: 0;
    --fill-color: var(--color-clear);
    --line-color: var(--color-clear);
    --backdrop-blur: 0;
    --cut-size: 0;
}

.classic #Disclaimer .dialog__card {
    margin-top: 104px;
    height: 880px;
    justify-content: flex-start;
}

.classic .dialog__title {
    margin: 0;
    font-size: 70px;
    -unity-font-definition: var(--classic-font-bold);
    -unity-font-style: normal;
    color: var(--classic-blue);
}

.classic .dialog__text {
    align-self: stretch;
    margin: 43px 0 0 0;
    font-size: 36px;
    -unity-font-definition: var(--font-display);
    -unity-text-align: upper-left;
}

.classic #CloseDisclaimer {
    position: absolute;
    left: 506.2px;
    top: 744.8px;
    min-width: 0;
    width: 275.7px;
    height: 58.4px;
    margin: 0;
    padding: 0;
    font-size: 30px;
    -unity-font-style: normal;
    --cut-size: 0;
    --backdrop-blur: 0;
    --line-color: var(--color-clear);
    --fill-color: var(--classic-blue);
}

.classic #CloseDisclaimer:hover:enabled,
.classic #CloseDisclaimer:focus {
    color: var(--color-text);
    --line-color: var(--color-clear);
    --fill-color: var(--classic-blue-hover);
}

.classic #CloseDisclaimer:active:enabled {
    color: var(--color-text);
    --fill-color: var(--classic-blue-pressed);
}

/* ---- Pause ---- */

/* Pause (the classic class is on #Pause): the original's panel sprite at 0.8 alpha sliding in over 0.167 s, easing in and
   out (flat tangents of PauseMenuAnimation), on black fading to 0.8 in the same time (BackgroundPause), the title in place.
   Nothing fades but the black: the screen stays opaque and only stays visible for the panel's slide out. On close, the
   black and the buttons go at once (the original deactivated them) and the empty panel slides out */
#Pause.classic {
    opacity: 1;
    transition-property: visibility;
    transition-duration: 0.167s;
}

#Pause.classic > .backdrop {
    background-color: var(--color-clear);
}

#Pause.classic.open > .backdrop {
    background-color: var(--classic-backdrop-pause);
    transition-property: background-color;
    transition-duration: 0.167s;
    transition-timing-function: ease-in-out;
}

#Pause.classic .pause {
    visibility: hidden;
}

/* The original's pause showed no summary of the run */
#Pause.classic .run-summary {
    display: none;
}

#Pause.classic.open .pause {
    visibility: visible;
}

#Pause.classic .side-panel {
    --fill-color: var(--color-clear);
    --line-color: var(--color-clear);
    --cut-size: 0;
    --backdrop-blur: 0;
    background-image: url("/Assets/Art/Classic/UI/Menus/Pause.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--classic-faded);
    transition-duration: 0.167s;
    transition-timing-function: ease-in-out;
}

.classic .pause__title {
    translate: 0 0;
    opacity: 1;
    transition-duration: 0s;
}

/* The original's layout (Canvas _ Pause, its panel at rest after PauseMenuAnimation): the panel 688 points wide from the
   right edge, over the whole height, also for the options; no title; Options, Resume, Main menu and Quit in upright
   Kallisto Bold 38, Options centered at 1766, 386, the others right-aligned on 1861 at 505, 624 and 736, a 235 point white
   line above each of these three */
#Pause.classic .side-panel,
#Pause.classic .side-panel.side-panel--wide {
    width: 688px;
}

#Pause.classic .pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

#Pause.classic .pause__title,
#Pause.classic .pause > .accent-line,
#Pause.classic .pause__list > .separator {
    display: none;
}

#Pause.classic .pause__list {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
}

#Pause.classic .pause__list > .menu-button {
    position: absolute;
    height: 48px;
    margin: 0;
    font-size: 38.4px;
    -unity-font-definition: var(--classic-font-bold);
    -unity-font-style: normal;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    -unity-text-align: middle-right;
}

#Pause.classic #OpenOptions {
    left: 402px;
    top: 366.2px;
    width: 255.8px;
    align-items: center;
    -unity-text-align: middle-center;
}

#Pause.classic #Resume {
    left: 154.4px;
    top: 485.5px;
    width: 470.5px;
}

#Pause.classic #MainMenu {
    left: 132.9px;
    top: 604.2px;
    width: 493.5px;
}

/* The original's pause had no new run */
#Pause.classic #NewRun {
    display: none;
}

#Pause.classic #Quit {
    left: 146.4px;
    top: 716.3px;
    width: 478.7px;
}

/* The lines, drawn by the buttons' bars as borders, 2 points tall: the original's 1.4 vanish below 1080p */
#Pause.classic #Resume > .menu-button__bar,
#Pause.classic #MainMenu > .menu-button__bar,
#Pause.classic #Quit > .menu-button__bar {
    right: auto;
    bottom: auto;
    width: 234.8px;
    height: 0;
    border-top-width: 2px;
    border-color: var(--classic-line);
    background-color: var(--color-clear);
    transition-duration: 0s;
}

#Pause.classic #Resume > .menu-button__bar {
    left: 234px;
    top: -39.1px;
}

#Pause.classic #MainMenu > .menu-button__bar {
    left: 255.5px;
    top: -38.6px;
}

#Pause.classic #Quit > .menu-button__bar {
    left: 242px;
    top: -34.3px;
}

/* The pause's options (Canvas _ Pause, OptionsOpen), in the same 688 point panel: a 544 point column from 1308; the title
   in upright Kallisto Bold 39.5, 219 by 55 at 1649, 47; white lines 3.4 tall at 127 and 755; the section titles (our tabs)
   in upright Kallisto Bold 26 on the right, at 170; the settings right-aligned on 1852, their names in Bicyclette 27; Return
   290 by 54 at 1600, 937; Default settings the white outline of DefaultParametersButton_Ingame, 234 by 54, Kallisto Medium
   15, on the left (the original's sat level with each section title, where our tabs are: ours on Return's line, at 1316).
   The panel's top is 4 points above the screen */
#Pause.classic .side-panel.side-panel--wide {
    padding: 51px 71.7px 0 71.8px;
    justify-content: flex-start;
}

#Pause.classic .options {
    width: 544.5px;
    align-self: flex-start;
}

#Pause.classic .options__header {
    align-items: flex-end;
    height: 55px;
    margin-bottom: 24.5px;
}

#Pause.classic .options__header > .title {
    width: 219px;
    height: 55px;
    margin-right: -15.7px;
    font-size: 39.5px;
}

#Pause.classic .options__tabs {
    justify-content: flex-end;
    border-top-width: 3.4px;
    padding-top: 36px;
    margin-bottom: 28px;
}

#Pause.classic .menu-button.options-tab {
    margin: 0 0 0 24px;
    font-size: 25.9px;
    -unity-font-definition: var(--classic-font-bold);
}

#Pause.classic .options__page {
    height: 530px;
    border-bottom-width: 3.4px;
}

#Pause.classic .setting {
    align-items: flex-end;
}

#Pause.classic .setting > .unity-label {
    font-size: 27px;
    -unity-text-align: middle-right;
}

#Pause.classic .setting > .setting__value,
#Pause.classic .setting:hover > .setting__value {
    left: auto;
    right: 240px;
    font-size: 14px;
    -unity-text-align: middle-right;
}

#Pause.classic .language-list > .outline-button {
    margin: 0 0 0 16px;
}

#Pause.classic .options__footer {
    position: absolute;
    left: 0;
    top: 890px;
    right: 0;
    height: 54.4px;
    margin: 0;
}

/* Return: its 289.9 by 54.4 rect kept the sprite's proportions (preserveAspect), 219 points wide in its middle */
#Pause.classic .options__footer > #Back {
    position: absolute;
    left: 292.2px;
    top: 0;
    width: 289.9px;
    height: 54.4px;
    font-size: 19.9px;
    -unity-background-scale-mode: scale-to-fit;
}

#Pause.classic .options__footer > .outline-button.reset-button {
    position: absolute;
    left: 8.2px;
    top: 0.2px;
    width: 233.5px;
    height: 54px;
    font-size: 15px;
    background-image: url("/Assets/Art/Classic/UI/Menus/Options/DefaultParametersButton_Ingame.png");
}

/* ---- Dialogs and results ---- */

/* The dialog appears at its size */
.classic .dialog__card {
    scale: 1 1;
    transition-duration: 0s;
}

/* Results (the classic class is on #Results): the original's death screen, black at 0.9, the texts in place, a 36 px
   message in its pink or green, a 25 px score, 250 by 70 DeathScreenButton buttons with 20 px texts */
.classic.results > .backdrop {
    background-color: var(--classic-backdrop-results);
}

.classic.results > .unity-label,
.classic.results > .results__buttons {
    translate: 0 0;
    opacity: 1;
    transition-duration: 0s;
}

/* The original's layout (Canvas _ Death): the message centered on 465, the buttons 250 by 70 at 665 and 1005, 505, the
   score under them, centered on 620. The message and the buttons were "Kallisto Bold Italic SDF small", the real Bold
   Italic face without a synthetic style */
.classic .results__message {
    position: absolute;
    left: 570px;
    top: 450px;
    width: 780px;
    height: 30.7px;
    margin: 0;
    font-size: 36px;
    -unity-font-definition: url("/Assets/TextMesh Pro/Resources/Fonts & Materials/Kallisto/Source/Kallisto Bold Italic.otf");
    -unity-font-style: normal;
    text-shadow: 0 0 0 var(--color-clear);
}

.classic .results__buttons {
    position: absolute;
    left: 665px;
    top: 505px;
    width: 590px;
    height: 70px;
    justify-content: space-between;
}

/* The original showed the score alone */
.classic .results__summary {
    display: none;
}

/* The original had no leaderboard, nor the artifacts */
.classic .results__rank,
.classic .results__artifacts {
    display: none;
}

/* The best score, plain, under the score: the original kept none */
.classic .results__best,
.classic .results__best--new {
    position: absolute;
    left: 784.8px;
    top: 640px;
    width: 350.4px;
    margin: 0;
    font-size: 18px;
    color: var(--classic-text);
    -unity-font-definition: var(--classic-font-bold);
    -unity-font-style: normal;
}

.classic .results__score {
    position: absolute;
    left: 784.8px;
    top: 609.1px;
    width: 350.4px;
    height: 21.9px;
    margin: 0;
}

.classic .results__message.defeat {
    color: var(--classic-defeat);
}

.classic .results__message.victory {
    color: var(--classic-victory);
}

.classic .results__score {
    font-size: 25px;
    text-shadow: 0 0 0 var(--color-clear);
}

.classic .results__buttons > .outline-button {
    min-width: 0;
    width: 250px;
    height: 70px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    -unity-font-definition: url("/Assets/TextMesh Pro/Resources/Fonts & Materials/Kallisto/Source/Kallisto Bold Italic.otf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    text-shadow: 0 0 0 var(--color-clear);
    --fill-color: var(--color-clear);
    --line-color: var(--color-clear);
    --cut-size: 0;
    --backdrop-blur: 0;
    background-image: url("/Assets/Art/Classic/UI/Menus/DeathScreenButton.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* The screens and the main menu's side panels show at once (the pause keeps its slide, #Pause.classic being more specific) */
.classic.screen,
.classic .screen,
.classic .side-panel {
    transition-duration: 0s;
}
