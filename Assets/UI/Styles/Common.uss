/* Shared look of every UI Toolkit screen: colors, fonts, glass panels, buttons and sliders */

:root {
    --color-text: #FFFFFF;
    --color-muted: #9A9A9A;
    --color-accent: #E82A65;
    --color-victory: #19CF15;
    --color-info: #5252EF;
    --color-glass: rgba(20, 22, 30, 0.45);
    --color-overlay: rgba(0, 0, 0, 0.35);
    --font-display: url("/Assets/TextMesh Pro/Resources/Fonts & Materials/Kallisto/Source/Kallisto Bold Italic.otf");
    --font-body: url("/Assets/TextMesh Pro/Resources/Fonts & Materials/Bicyclette/Source/Bicyclette-Regular.ttf");

    -unity-font-definition: var(--font-body);
    color: var(--color-text);
    font-size: 24px;
}

/* A screen fills the panel and fades in when it gets the open class */
.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, visibility;
    transition-duration: 0.25s;
}

.screen.open {
    opacity: 1;
    visibility: visible;
}

/* Darkens the game behind a screen */
.backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-overlay);
}

/* Frosted panel with the slanted corners of the game's UI, drawn by CutShape */
.glass {
    --fill-color: var(--color-glass);
    --line-color: var(--color-text);
    --line-width: 2;
    --backdrop-blur: 24;
}

/* Panel sliding in from the right edge, its top left corner cut. Its top, right and bottom lines are out of the screen */
.side-panel {
    position: absolute;
    top: -4px;
    right: -4px;
    bottom: -4px;
    width: 36%;
    padding: 64px 74px;
    justify-content: center;
    align-items: flex-end;
    --cut-size: 80;
    --cut-corners: "top-left";
    translate: 100% 0;
    transition-property: translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-cubic;
}

.open .side-panel {
    translate: 0 0;
}

.view {
    align-items: flex-end;
    align-self: stretch;
}

.hidden {
    display: none;
}

.title {
    -unity-font-definition: var(--font-display);
    font-size: 48px;
    -unity-text-align: middle-right;
}

.section-title {
    -unity-font-definition: var(--font-display);
    font-size: 30px;
    margin-top: 12px;
    -unity-text-align: middle-right;
}

.separator {
    align-self: stretch;
    height: 2px;
    margin: 16px 0;
    background-color: var(--color-text);
}

.separator--short {
    align-self: flex-end;
    width: 300px;
}

/* The text buttons drop the default theme's background in every state; hovering or focusing them only colors them */
.unity-button.menu-button,
.unity-button.outline-button,
.unity-button.menu-button:hover:enabled,
.unity-button.outline-button:hover:enabled,
.unity-button.menu-button:active:enabled,
.unity-button.outline-button:active:enabled,
.unity-button.menu-button:focus,
.unity-button.outline-button:focus {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* Big uppercase text button of the menus */
.menu-button {
    -unity-font-definition: var(--font-display);
    font-size: 44px;
    -unity-text-align: middle-right;
    margin: 0;
    padding: 4px 0;
    color: var(--color-text);
    transition-property: color;
    transition-duration: 0.15s;
}

.menu-button:hover,
.menu-button:focus {
    color: var(--color-accent);
}

.menu-button:active {
    color: var(--color-muted);
}

/* Small button with the slanted outline, drawn by CutShape */
.outline-button {
    -unity-font-definition: var(--font-display);
    font-size: 22px;
    min-width: 280px;
    height: 56px;
    margin: 8px 0;
    padding: 0 40px;
    color: var(--color-text);
    --cut-size: 22;
    --cut-corners: "top-left bottom-right";
    --fill-color: rgba(0, 0, 0, 0.35);
    --line-color: var(--color-text);
    --line-width: 2;
    --backdrop-blur: 10;
    transition-property: color;
    transition-duration: 0.15s;
}

.outline-button:hover,
.outline-button:focus {
    color: var(--color-accent);
    --line-color: var(--color-accent);
    --fill-color: rgba(232, 42, 101, 0.12);
}

.outline-button:active {
    color: var(--color-muted);
}

/* Setting: its name above a slider */
.setting {
    align-self: stretch;
    align-items: flex-end;
    margin: 6px 0;
}

.setting > .unity-label {
    -unity-text-align: middle-right;
}

.setting-slider {
    width: 360px;
    margin: 4px 0;
}

.setting-slider #unity-tracker {
    height: 3px;
    margin-top: -1px;
    background-color: var(--color-text);
    border-width: 0;
}

.setting-slider #unity-dragger {
    width: 22px;
    height: 22px;
    margin-top: -10px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Art/UI/Settings/CursorOptions.png");
    border-width: 0;
}

.setting-slider #unity-dragger-border {
    display: none;
}

.setting-slider:hover #unity-dragger,
.setting-slider:focus #unity-dragger {
    -unity-background-image-tint-color: var(--color-accent);
}

/* End of run screen */
.backdrop--dark {
    background-color: rgba(0, 0, 0, 0.6);
}

.results {
    justify-content: center;
    align-items: center;
}

.results__message {
    font-size: 72px;
    -unity-text-align: middle-center;
}

.results__message.victory {
    color: var(--color-victory);
}

.results__message.defeat {
    color: var(--color-accent);
}

.results__score {
    -unity-text-align: middle-center;
    margin-bottom: 40px;
}

.results__buttons {
    flex-direction: row;
}

.results__buttons > .outline-button {
    margin: 0 20px;
}

/* Main menu */
.main-menu {
    align-items: center;
    justify-content: center;
}

.main-menu__logo {
    width: 1080px;
    height: 415px;
    margin-bottom: 40px;
    background-image: url("/Assets/Art/Branding/Logo_TTU_Final White.png");
    -unity-background-scale-mode: scale-to-fit;
}

.main-menu__buttons {
    align-items: center;
}

.main-menu .menu-button {
    -unity-text-align: middle-center;
}

.main-menu .separator--short {
    align-self: center;
    width: 120px;
}

.main-menu__play {
    font-size: 60px;
}

/* Credits scrolling up in the side panel while they are open */
.credits {
    flex-grow: 1;
    align-self: stretch;
    overflow: hidden;
}

.credits__content {
    align-items: flex-end;
}

.open .credits__content {
    translate: 0 -100%;
    transition-property: translate;
    transition-duration: 35s;
    transition-timing-function: linear;
}

.credits__role {
    -unity-font-definition: var(--font-display);
    font-size: 34px;
    margin-top: 36px;
    -unity-text-align: middle-right;
}

.credits__names {
    font-size: 26px;
    -unity-text-align: middle-right;
    color: var(--color-muted);
}

/* Centered popup */
.popup {
    align-items: center;
    justify-content: center;
}

.popup__card {
    width: 900px;
    padding: 60px 80px;
    align-items: center;
    --cut-size: 40;
    --cut-corners: "top-left bottom-right";
}

.popup__title {
    color: var(--color-info);
    -unity-text-align: middle-center;
}

.popup__text {
    margin: 30px 0;
    white-space: normal;
    -unity-text-align: middle-center;
}
