/* Shared look of every UI Toolkit screen: colors, fonts, panels, buttons, separators and sliders */

/* Design tokens: use them rather than literal values; a value used once for a layout stays literal */
:root {
    /* Text levels: main, secondary (stat lines, descriptions), muted (hints, keys, pressed) */
    --color-text: #FFFFFF;
    --color-text-secondary: #CCCCCC;
    --color-muted: #9A9A9A;

    /* The accent (hover, lethal, defeat), its pale tint (hovered inventory piece) and the selected skill */
    --color-accent: #E82A65;
    --color-accent-light: #FFC9D7;
    --color-selected: #7459D8;
    --color-victory: #19CF15;
    --color-info: #5252EF;
    /* Allowed: the room the player is in, the slots a held item can go to */
    --color-valid: #1ECC55;

    /* Colors of the stats, shared by their bars and their texts. The shield color is also the armor and defense one */
    --color-health: #E22E55;
    --color-health-trail: #F4B3C2;
    --color-hit-flash: #FFFFFF;
    --color-shield: #17B2E6;
    --color-energy: #5844CC;
    --color-energy-text: #8F80F0;
    --color-energy-empty: #9D9BBA;
    --color-attack: #F2A33A;
    --color-movement: #20D15F;

    /* Feedback: heals, buffs and debuffs, and the warning of a second press or of a hit that may kill */
    --color-heal: #19CF15;
    --color-buff: #19CF15;
    --color-debuff: #E82A65;
    --color-warning: #F2A33A;

    /* Darken the game behind a screen; the wipes covering the screen (the panel fill, opaque) */
    --color-overlay: rgba(0, 0, 0, 0.3);
    --color-overlay-dark: rgba(0, 0, 0, 0.55);
    --color-fade: #0C0E16;

    /* Every panel: a light frosted fill, a thin line and a blur of what is behind */
    --panel-fill: rgba(12, 14, 22, 0.5);
    --panel-fill-hover: rgba(232, 42, 101, 0.12);
    --panel-line: rgba(255, 255, 255, 0.85);
    --panel-line-width: 1;
    --panel-line-width-bold: 1.5;
    --panel-blur: 20;

    /* Thin lines drawn as borders: separators, headers and frames */
    --color-separator: rgba(255, 255, 255, 0.6);
    --border-width: 1px;

    /* Ultra sharp shadows, under the opaque shapes and the display texts */
    --sharp-shadow: rgba(0, 0, 0, 0.55);

    --font-display: url("/Assets/TextMesh Pro/Resources/Fonts & Materials/Kallisto/Source/Kallisto Bold Italic.otf");
    --font-body: url("/Assets/TextMesh Pro/Resources/Fonts & Materials/Bicyclette/Source/Bicyclette-Regular.ttf");

    /* Type scale */
    --font-size-xs: 14px;
    --font-size-sm: 16px;
    --font-size-md: 18px;
    --font-size-base: 22px;
    --font-size-lg: 24px;
    --font-size-xl: 28px;
    --font-size-2xl: 36px;
    --font-size-3xl: 52px;

    /* Layout shared by the HUD and the inventory: three columns, 48 points from the edges */
    --space-edge: 48px;
    --column-side: 600px;
    --column-middle: 420px;

    /* Transitions: a press, a hover or a popup, a pop, a screen fade, a panel opening, a slide, a wipe each way */
    --duration-press: 0.1s;
    --duration-fast: 0.15s;
    --duration-medium: 0.2s;
    --duration-fade: 0.25s;
    --duration-slow: 0.3s;
    --duration-slide: 0.35s;
    --duration-wipe: 0.4s;

    -unity-font-definition: var(--font-body);
    color: var(--color-text);
    font-size: var(--font-size-base);
}

/* A screen fills the 16:9 area and fades in when it gets the open class */
.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, visibility;
    transition-duration: var(--duration-fade);
}

.screen.open {
    opacity: 1;
    visibility: visible;
}

/* Darkens the game behind a screen, without blurring it: only the panels blur what is behind them */
.backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-overlay);
}

.backdrop--dark {
    background-color: var(--color-overlay-dark);
}

/* Slanted bands covering the screen during the room changes and the scene loads (SlantedWipe: ScreenFade, SceneTransition) */
.slanted-wipe {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --fill-color: var(--color-fade);
    /* Plain bands, no line on their moving edge */
    --line-color: rgba(0, 0, 0, 0);
    --wipe-duration: var(--duration-wipe);
}

/* Frosted panel with the slanted corners of the game's UI, drawn by CutShape (with the cut class) */
.panel {
    --fill-color: var(--panel-fill);
    --line-color: var(--panel-line);
    --line-width: var(--panel-line-width);
    --backdrop-blur: var(--panel-blur);
}

/* Dot at an end of a panel's line */
.dot {
    position: absolute;
    top: -3px;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--color-text);
}

.dot--left {
    left: -3px;
}

.dot--right {
    right: -3px;
}

.dot--bottom {
    top: auto;
    bottom: -3px;
}

.hidden {
    display: none;
}

.view {
    align-items: flex-end;
    align-self: stretch;
}

.title {
    -unity-font-definition: var(--font-display);
    font-size: 40px;
    -unity-text-align: middle-right;
    text-shadow: 3px 3px 0 var(--sharp-shadow);
}

.section-title {
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-lg);
    margin-top: 8px;
    -unity-text-align: middle-right;
    text-shadow: 2px 2px 0 var(--sharp-shadow);
}

/* A thin line drawn as a border: a 1px tall element is rounded to 0 or 1 pixel under 1080p and vanishes, a border stays drawn */
.separator {
    align-self: stretch;
    margin: 14px 0;
    border-top-width: var(--border-width);
    border-color: var(--color-separator);
}

.separator--short {
    align-self: flex-end;
    width: 220px;
}

/* The space of a separator, without its line */
.separator--blank {
    border-color: rgba(0, 0, 0, 0);
}

/* Sets the first action of a menu apart from the others */
.separator--group {
    margin: 22px 0 26px 0;
    border-color: var(--panel-line);
}

.menu-button--primary {
    font-size: 42px;
    height: 58px;
}

/* The custom buttons drop the default theme's background, border and margin. The states only repeat the
   background and border: a state setting a layout property would move the button and its neighbours on hover */
.unity-button.flat-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
}

.unity-button.flat-button:hover:enabled,
.unity-button.flat-button:active:enabled,
.unity-button.flat-button:focus {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* Not clickable, but not dimmed */
.unity-button.flat-button.unity-disabled {
    opacity: 1;
}

/* Big uppercase text button of the menus (MenuButton): hovering it colors it and draws its accent bar.
   In a menu list, the buttons slide in one after the other when the screen opens (delays set by MenuScreen).
   Its text is a child label that gives it its width, centered in its height; the text styles are inherited */
.menu-button {
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-2xl);
    height: 52px;
    justify-content: center;
    -unity-text-align: middle-right;
    padding: 0;
    color: var(--color-text);
    text-shadow: 3px 3px 0 var(--sharp-shadow);
    transition-property: translate, opacity, color;
    transition-duration: var(--duration-slide), var(--duration-slide), var(--duration-fast);
    transition-timing-function: ease-out-cubic;
}

.menu-button__text {
    margin: 0;
    padding: 0;
}

.menu-list > .menu-button {
    translate: 32px 0;
    opacity: 0;
}

.open .menu-list > .menu-button {
    translate: 0 0;
    opacity: 1;
}

/* Asks for a second click before leaving */
.menu-button.confirm .menu-button__text {
    color: var(--color-warning);
}

.menu-button:hover,
.menu-button:focus {
    color: var(--color-accent);
}

.menu-button:active {
    color: var(--color-muted);
}

.menu-button__bar {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-accent);
    transition-property: width;
    transition-duration: var(--duration-medium);
    transition-timing-function: ease-out-cubic;
}

.menu-button:hover > .menu-button__bar,
.menu-button:focus > .menu-button__bar {
    width: 64px;
}

/* Small button with the slanted outline (SlantedButton) */
.outline-button {
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-md);
    min-width: 240px;
    height: 46px;
    margin: 6px 0;
    padding: 0 36px;
    color: var(--color-text);
    --cut-size: 18;
    --backdrop-blur: 10;
    text-shadow: 2px 2px 0 var(--sharp-shadow);
    transition-property: color, scale;
    transition-duration: var(--duration-fast), var(--duration-press);
}

.outline-button:hover,
.outline-button:focus {
    color: var(--color-accent);
    --line-color: var(--color-accent);
    --fill-color: var(--panel-fill-hover);
}

.outline-button:active {
    scale: 0.97 0.97;
}

/* The chosen option of a row of outline buttons, such as the language */
.outline-button--selected {
    color: var(--color-accent);
    --line-color: var(--color-accent);
}

/* The language buttons of the options, side by side */
.language-list {
    flex-direction: row;
    justify-content: flex-end;
}

.language-list > .outline-button {
    min-width: 0;
    width: 182px;
    height: 38px;
    margin: 0 0 0 16px;
    padding: 0;
    font-size: var(--font-size-sm);
    -unity-text-align: middle-center;
}

/* Setting: its name on the left, its control on the right, a faint line under it.
   A slider shows its value after it (setting__value, added by OptionsView) */
.setting {
    align-self: stretch;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    height: 64px;
    border-bottom-width: var(--border-width);
    border-color: rgba(255, 255, 255, 0.08);
}

.setting > .unity-label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    -unity-text-align: middle-left;
    margin: 0 16px 0 0;
    padding: 0;
    transition-property: color;
    transition-duration: var(--duration-fast);
}

.setting:hover > .unity-label {
    color: var(--color-text);
}

.setting > .setting__value {
    flex-grow: 0;
    width: 64px;
    margin: 0 0 0 16px;
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-md);
    color: var(--color-text);
    -unity-text-align: middle-right;
}

.setting-slider {
    width: 300px;
    flex-shrink: 0;
    margin: 0;
    /* Its track sits high in its box: level with the name */
    translate: 0 11px;
}

.setting > .outline-button {
    min-width: 0;
    /* As wide as a slider and its value */
    width: 380px;
    height: 38px;
    margin: 0;
    padding: 0;
    font-size: var(--font-size-sm);
    -unity-text-align: middle-center;
}

/* The views of a panel keep their size: a panel too short scrolls rather than squeezing them */
.view > * {
    flex-shrink: 0;
}

.setting-slider #unity-tracker {
    height: 2px;
    margin-top: -1px;
    background-color: rgba(255, 255, 255, 0.3);
    border-width: 0;
}

/* The filled part of the track, before the dragger */
.setting-slider #unity-fill {
    height: 2px;
    margin-top: -1px;
    background-color: var(--color-accent);
}

.setting-slider #unity-dragger {
    width: 18px;
    height: 18px;
    margin-top: -8px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Art/UI/Settings/CursorOptions.png");
    border-width: 0;
    transition-property: scale;
    transition-duration: var(--duration-press);
}

.setting-slider #unity-dragger-border {
    display: none;
}

.setting-slider:hover #unity-dragger,
.setting-slider:focus #unity-dragger {
    -unity-background-image-tint-color: var(--color-accent);
    scale: 1.15 1.15;
}

/* A popup shown with the shown class: it fades in */
.fade-in {
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, visibility, translate, scale;
    transition-duration: var(--duration-fast);
    transition-timing-function: ease-out-cubic;
}

.fade-in.shown {
    opacity: 1;
    visibility: visible;
}

/* A stat's text in the color of its bar */
.unity-label.stat--health {
    color: var(--color-health);
}

.unity-label.stat--energy {
    color: var(--color-energy-text);
}

.unity-label.stat--attack {
    color: var(--color-attack);
}

.unity-label.stat--defense {
    color: var(--color-shield);
}

/* Energy cost (CostTag): an opaque parallelogram with its sharp shadow */
.cost-tag {
    width: 50px;
    height: 18px;
    --cut-size: 18;
    --fill-color: var(--color-energy);
    --shadow-offset: 2;
    --shadow-color: var(--sharp-shadow);
}

.cost-tag__value {
    flex-grow: 1;
    -unity-font-definition: var(--font-display);
    font-size: 15px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}
