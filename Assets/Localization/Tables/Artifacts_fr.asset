      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1735311479
    m_Localized: "Port\xE9e : {minRange}"
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1735311480
    m_Localized: 'Utilisation par tour : {value}'
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1735311481
    m_Localized: Flash noir
    m_Metadata:
      m_Items: []
  - m_Id: 1735311482
    m_Localized: "Au d\xE9but le n\xE9ant \nDes t\xE9n\xE8bres naquit l'\xE9clat \n\xC9teint la mort la vie"
    m_Metadata:
      m_Items: []
  - m_Id: 1735311483
    m_Localized: "Inflige <D>{minDamage}</D> \xE0 <D>{maxDamage}</D> d\xE9g\xE2ts"
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1735311484
    m_Localized: "Port\xE9e : Ligne de {minRange} \xE0 {maxRange}"
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1735311485
    m_Localized: 'Cooldown : {value}'
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1735311486
    m_Localized: Bastion
    m_Metadata:
      m_Items: []
  - m_Id: 1739505664
    m_Localized: "L'abolition des plaies \nLe banissement des douleurs \nPour une vie sans fin"
    m_Metadata:
      m_Items: []
  - m_Id: 1739505665
    m_Localized: "Repousse de {distance} cases les ennemis adjacents, s'octroie <B>{armor}</B> d'armure et augmente sa d\xE9fense pendant <B>{defenseUpTurns}</B> tours"
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1739505666
    m_Localized: "Port\xE9e : {minRange} / Zone d'effet : {minArea}"
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1739505667
    m_Localized: 'Cooldown : {value}'
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1739505668
    m_Localized: "Execution \xE9clair"
    m_Metadata:
      m_Items: []
  - m_Id: 1739505669
    m_Localized: "Un seul coup fulgurant \nLa vie dispara\xEEt dans un flash \nLe calme retombe"
    m_Metadata:
      m_Items: []
  - m_Id: 1739505670
    m_Localized: "Inflige <D>{minDamage}</D> \xE0 <D>{maxDamage}</D> d\xE9g\xE2ts et augmente l'attaque pendant <B>{attackUpTurns}</B> tours"
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1739505671
    m_Localized: "Port\xE9e : {minRange}"
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1739505672
    m_Localized: 'Utilisation par tour : {value}'
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1739505673
    m_Localized: Cartouche incendiaire
    m_Metadata:
      m_Items: []
  - m_Id: 1739505674
    m_Localized: "Le feu face \xE0 l'Eko \nLa science face \xE0 l'inconnu \nL'humain face \xE0 sa fin"
    m_Metadata:
      m_Items: []
  - m_Id: 1739505675
    m_Localized: "Inflige <D>{minDamage}</D> \xE0 <D>{maxDamage}</D> d\xE9g\xE2ts"
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1739505676
    m_Localized: "Port\xE9e : {minRange} \xE0 {maxRange}"
    m_Metadata:
      m_Items:
