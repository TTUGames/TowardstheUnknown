    m_Localized: 'Utilisation par tour : {value}'
    m_Metadata:
      m_Items:
      - rid: 1441196401341759517
  - m_Id: 1739505678
    m_Localized: Barriere
    m_Metadata:
      m_Items: []
  - m_Id: 1739505679
    m_Localized: "Un mur de lumi\xE8re \nFait face \xE0 tout danger \nCrucial \xE0 la survie"
    m_Metadata:
      m_Items: []
  - m_Id: 1739505680
    m_Localized: Octroie <B>{armor}</B> d'armure
    m_Metadata:
      m_Items:
