  - m_Id: 1739505668
    m_Localized: Lightning execution
    m_Metadata:
      m_Items: []
  - m_Id: 1739505669
    m_Localized: 'A single swift strike

      Life vanishes in a flash

      And the calm returns'
    m_Metadata:
