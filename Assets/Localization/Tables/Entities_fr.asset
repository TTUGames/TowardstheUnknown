  - m_Id: 1250472881995776
    m_Localized: "Mannequin d'entra\xEEnement"
    m_Metadata:
      m_Items: []
  - m_Id: 3710332739436544
    m_Localized: "Griffe au corps \xE0 corps."
    m_Metadata:
      m_Items: []
  - m_Id: 3710339660038144
    m_Localized: "Griffe au corps \xE0 corps et hurle pour renforcer son attaque."
    m_Metadata:
      m_Items: []
  - m_Id: 3710346245095424
    m_Localized: "Frappe au contact ; ses flammes spectrales portent \xE0 2 cases et affaiblissent votre attaque."
    m_Metadata:
      m_Items: []
  - m_Id: 3710352800792576
    m_Localized: "Charge jusqu'\xE0 4 cases en ligne droite et renforce sa d\xE9fense."
    m_Metadata:
      m_Items: []
  - m_Id: 3710359469735936
    m_Localized: "Fait pleuvoir des rochers de 2 \xE0 5 cases ; au contact, son onde de choc repousse de 3 cases."
    m_Metadata:
      m_Items: []
  - m_Id: 3710366025433088
    m_Localized: Le gardien de la faille. Il change de forme quand il faiblit.
    m_Metadata:
      m_Items: []
  - m_Id: 3710372610490368
    m_Localized: "Un mannequin d'entra\xEEnement : il encaisse sans riposter."
    m_Metadata:
      m_Items: []
